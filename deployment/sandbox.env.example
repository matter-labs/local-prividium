# Public deployment identity
SANDBOX_DOMAIN=sandbox.example.com
ACME_EMAIL=ops@example.com
SANDBOX_ADMIN_EMAIL=admin@local.dev
CHAIN_NAME="Prividium Sandbox"
L2_CHAIN_ID=1900000001
L1_CHAIN_ID=11155111
ETH_PRICE_USD=3000
RUNTIME_DIR=../deployment/runtime

# Use separate endpoints. The browser endpoint is intentionally public and CORS-enabled.
SEPOLIA_RPC_URL=https://private-sepolia-rpc.example.invalid
SEPOLIA_BROWSER_RPC_URL=https://public-sepolia-rpc.example.invalid

# One-time L1 deployment and ZKsync role keys
