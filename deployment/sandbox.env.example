AUTH_SERVER_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
AUTH_SERVER_ADMIN_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
AUTH_SERVER_ADMIN_ADDRESS=0x0000000000000000000000000000000000000001
INSTITUTIONAL_DEMO_DEPLOYER_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
SERVICE_WALLET_TARGET_L2_ETH=0.05
FACTORY_DEPLOYER_FUNDING_ETH=0.012

# Databases
