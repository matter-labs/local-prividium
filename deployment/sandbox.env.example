OPERATOR_COMMIT_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
OPERATOR_PROVE_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
OPERATOR_EXECUTE_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
# Runtime safety and alert floors.
OPERATOR_MIN_L1_BALANCE_WEI=10000000000000000
DEPLOYMENT_SIGNER_MIN_L1_BALANCE_WEI=10000000000000000

# Application and service wallets
BRIDGE_SPONSOR_PRIVATE_KEY=REPLACE_WITH_RANDOM_PRIVATE_KEY
