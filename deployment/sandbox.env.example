# Identity, sessions, monitoring, and service authentication
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_RANDOM_USERNAME
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SANDBOX_ADMIN_PASSWORD=password
SANDBOX_USER_1_EMAIL=user1@local.dev
