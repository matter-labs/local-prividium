#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
encrypted="${1:-${repo_root}/deployment/secrets/sandbox.enc.env}"
runtime_dir="${RUNTIME_DIR:-/etc/prividium/runtime}"
output="${runtime_dir}/sandbox.env"

command -v sops >/dev/null || {
  echo "sops is required" >&2
  exit 1
}
if [[ ! -s "$encrypted" ]]; then
  echo "Encrypted secret file not found: ${encrypted}" >&2
  exit 1
fi

mkdir -p "$runtime_dir"
if [[ -L "$output" || ( -e "$output" && ! -f "$output" ) ]]; then
  echo "Refusing to replace an unsafe runtime environment path: ${output}" >&2
  exit 1
fi
temporary=$(mktemp "${runtime_dir}/sandbox.env.XXXXXX")
trap 'rm -f "$temporary"' EXIT
sops --decrypt --input-type dotenv --output-type dotenv "$encrypted" >"$temporary"

for required in SANDBOX_DOMAIN L2_CHAIN_ID SEPOLIA_RPC_URL OPERATOR_COMMIT_PRIVATE_KEY; do
  if ! grep -q "^${required}=" "$temporary"; then
    echo "Decrypted secret file is missing ${required}" >&2
    exit 1
  fi
done

chmod 0600 "$temporary"
mv "$temporary" "$output"
chmod 0600 "$output"
trap - EXIT
echo "Decrypted runtime environment written to ${output} with mode 0600"
