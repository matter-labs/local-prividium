#!/usr/bin/env bash
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
compose_dir="${repo_root}/compose"
compose_file="${compose_dir}/compose.yaml"
funding_targets_file="${FUNDING_TARGETS_FILE:-${repo_root}/deployment/funding-targets.json}"
environment_file="${1:-${repo_root}/deployment/sandbox.env.example}"
rendered=$(mktemp)
images=$(mktemp)
default_services=$(mktemp)
default_model=$(mktemp)
trap 'rm -f "$rendered" "$images" "$default_services" "$default_model"' EXIT

cd "$repo_root"

if ! jq -e '
  type == "object" and
  (keys | sort) == ["canary_reserve_wei", "l1_chain_id", "schema_version", "targets_wei"] and
  .schema_version == 1 and
  .l1_chain_id == 11155111 and
  (.canary_reserve_wei | type == "string" and test("^[1-9][0-9]*$")) and
  (.targets_wei | keys | sort) == [
    "chain_owner",
    "ecosystem_governor",
    "l1_deployer",
    "operator_commit",
    "operator_execute",
    "operator_prove"
  ] and
  (.targets_wei | all(type == "string" and test("^[1-9][0-9]*$")))
' "$funding_targets_file" >/dev/null; then
  echo "Funding targets must use the exact six-role Sepolia schema" >&2
  exit 1
fi

compose_modules=(
  platform.yaml
  permissioning.yaml
  explorer.yaml
  monitoring.yaml
  optional.yaml
  demos.yaml
)
for module in "${compose_modules[@]}"; do
  if [[ ! -s "${compose_dir}/${module}" ]]; then
    echo "Compose module is missing or empty: ${module}" >&2
    exit 1
  fi
  if ! grep -Fq -- "- ${module}" "$compose_file"; then
    echo "Root Compose entrypoint does not include ${module}" >&2
    exit 1
  fi
done
if [[ -e "${compose_dir}/docker-compose-deps.yaml" ||
      -e "${compose_dir}/docker-compose-examples.yaml" ]]; then
  echo "Legacy monolithic Compose files must not be restored" >&2
  exit 1
fi
if grep -Eq '^  institutional-demo[^:]*:' "${compose_dir}/optional.yaml"; then
  echo "Demo services must remain isolated in compose/demos.yaml" >&2
  exit 1
fi
if ! grep -Eq '^  institutional-demo:' "${compose_dir}/demos.yaml"; then
  echo "compose/demos.yaml does not define the institutional demo app" >&2
  exit 1
fi

docker compose -f "$compose_file" \
  --env-file "$environment_file" config --services >"$default_services"
docker compose -f "$compose_file" \
  --env-file "$environment_file" config --format json >"$default_model"
compose_profiles=(--profile chain-bootstrap --profile sso --profile webhook --profile institutional-demo)
docker compose -f "$compose_file" \
  --env-file "$environment_file" "${compose_profiles[@]}" config >"$rendered"
docker compose -f "$compose_file" \
  --env-file "$environment_file" "${compose_profiles[@]}" config --images >"$images"

if ! jq -e '
  (.services | keys | sort) == [
    "admin-panel",
    "block-explorer-api",
    "block-explorer-app",
    "block-explorer-data-fetcher",
    "block-explorer-worker",
    "caddy",
    "chain-preflight",
    "grafana",
    "keycloak",
    "operator-balance-exporter",
    "postgres",
    "prividium-api",
    "prometheus",
    "user-panel",
    "zksyncos"
  ] and
  .services["chain-preflight"].restart == "no" and
  (.services |
    to_entries |
    all(
      .key == "chain-preflight" or
      .value.restart == "unless-stopped"
    )) and
  ([
    .services |
    to_entries[] |
    select(.value.build != null) |
    .key
  ] | sort) == [
    "chain-preflight",
    "operator-balance-exporter"
  ]
' "$default_model" >/dev/null; then
  echo "Default Compose model must contain the exact 14 long-running services and chain-preflight job" >&2
  exit 1
fi

if grep -Eqi 'https?://localhost|host\.docker\.internal|image:.*:latest([@[:space:]]|$)|^[[:space:]]+l1:[[:space:]]*$' "$rendered"; then
  echo "Rendered Compose contains a local-only host, Anvil, or a latest image" >&2
  exit 1
fi
if grep -Eq '31337|(^|[^0-9])6565([^0-9]|$)|424242' "$rendered"; then
  echo "Rendered Compose contains a legacy local chain ID" >&2
  exit 1
fi
if grep -Eqi 'ac0974|59c699|5de411|8b3a350|7726827c|aaaaaaaa00000000' "$rendered"; then
  echo "Rendered Compose contains a known deterministic development secret" >&2
  exit 1
fi

for optional_service in \
  auth-server auth-server-api bundler contracts-extractor entrypoint-deployer \
  sso-contracts-deployer sso-funds sso-permissions-setup sso-runtime-init \
  webhook-permissions-setup zksync-webhook-service \
  institutional-demo institutional-demo-deploy institutional-demo-funds \
  institutional-demo-identity institutional-demo-org-setup institutional-demo-seed; do
  if grep -Fxq "$optional_service" "$default_services"; then
    echo "Optional service is enabled in the default profile: ${optional_service}" >&2
    exit 1
  fi
done

while IFS= read -r image; do
  [[ "$image" == local/* ]] && continue
  if [[ "$image" != *@sha256:* ]]; then
    echo "Unpinned remote image: ${image}" >&2
    exit 1
  fi
done <"$images"

published=$(awk '
  /^[[:space:]]+published:/ { gsub(/"/, "", $2); print $2 }
' "$rendered" | sort -u | tr '\n' ' ')
if [[ "$published" != "3100 443 80 " && "$published" != "3100 80 443 " ]]; then
  echo "Unexpected published port set: ${published}" >&2
  exit 1
fi
if ! grep -B8 -A2 'published: "3100"' "$rendered" | grep -q 'host_ip: 127.0.0.1'; then
  echo "Grafana must be bound to loopback" >&2
  exit 1
fi

if ! jq -e '
  [
    .users[] |
    {
      id,
      username,
      email,
      emailVerified,
      enabled,
      requiredActions,
      credentials: [.credentials[] | {type, value, temporary}],
      realmRoles
    }
  ] == [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "${SANDBOX_ADMIN_EMAIL}",
      "email": "${SANDBOX_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": ["UPDATE_PASSWORD"],
      "credentials": [{
        "type": "password",
        "value": "${SANDBOX_ADMIN_PASSWORD}",
        "temporary": true
      }],
      "realmRoles": ["admin", "user"]
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "username": "${SANDBOX_USER_1_EMAIL}",
      "email": "${SANDBOX_USER_1_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": [],
      "credentials": [{
        "type": "password",
        "value": "${SANDBOX_USER_1_PASSWORD}",
        "temporary": false
      }],
      "realmRoles": ["user"]
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "username": "${SANDBOX_USER_2_EMAIL}",
      "email": "${SANDBOX_USER_2_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": [],
      "credentials": [{
        "type": "password",
        "value": "${SANDBOX_USER_2_PASSWORD}",
        "temporary": false
      }],
      "realmRoles": ["user"]
    }
  ]
' dev/keycloak/realm-export.json >/dev/null; then
  echo "The core Keycloak realm must contain the exact three evaluation users" >&2
  exit 1
fi
oidc_admin_subs=$(awk '
  /^[[:space:]]+OIDC_ADMIN_SUBS:/ { print $2 }
' "$rendered")
if [[ "$oidc_admin_subs" != "00000000-0000-0000-0000-000000000001" ]]; then
  echo "OIDC_ADMIN_SUBS must contain only the sandbox administrator subject" >&2
  exit 1
fi

for dockerfile in dev/bundler/contracts/Dockerfile dev/sso-setup/Dockerfile dev/monitoring/Dockerfile dev/chain-bootstrap/Dockerfile; do
  if grep -E '^FROM ' "$dockerfile" | grep -vq '@sha256:'; then
    echo "Unpinned Dockerfile base in ${dockerfile}" >&2
    exit 1
  fi
done

if grep -En \
  'REPLACE_WITH_RANDOM|https://private-|SEPOLIA_RPC_URL=|PRIVATE_KEY=|PASSWORD=' \
  deployment/public/*.md >/dev/null; then
  echo "A public Markdown report example appears to contain a secret or private provider value" >&2
  exit 1
fi

if ! jq -e '
  .l1_chain_id == 11155111 and
  .data_availability.mode == "no_da" and
  .data_availability.type == "validium" and
  .data_availability.l2_commitment_scheme == "empty_no_da" and
  (.data_availability | has("l1_validator")) and
  (.transaction_filterer | has("address")) and
  .transaction_filterer.chain_admin_whitelisted == true and
  .transaction_filterer.deposits_allowed == true and
  .security.proofs == "fake"
' deployment/public/manifest.example.json >/dev/null; then
  echo "Public manifest example must evidence Validium, filterer policy, and fake proofs" >&2
  exit 1
fi
if ! grep -Fq 'da_mode: no_da' dev/chain-bootstrap/bootstrap.sh ||
   ! grep -Fq 'DeployPrividiumTransactionFilterer.s.sol' dev/chain-bootstrap/bootstrap.sh; then
  echo "Chain bootstrap must deploy NoDA Validium with the official transaction filterer" >&2
  exit 1
fi

echo "Sandbox Compose static validation passed"
