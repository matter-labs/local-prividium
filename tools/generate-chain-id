#!/usr/bin/env bash
set -Eeuo pipefail

for command in curl jq openssl; do
  command -v "$command" >/dev/null || {
    echo "${command} is required" >&2
    exit 1
  }
done

chainlist_file=$(mktemp)
trap 'rm -f "$chainlist_file"' EXIT
curl --fail --silent --show-error --location \
  https://chainid.network/chains.json \
  --output "$chainlist_file"

for _ in $(seq 1 100); do
  random_hex=$(openssl rand -hex 4)
  candidate=$(( (16#$random_hex & 1073741823) | 1073741824 ))
  if jq -e --argjson id "$candidate" 'any(.[]; .chainId == $id)' "$chainlist_file" >/dev/null; then
    continue
  fi

  if [[ -n "${BRIDGEHUB_ADDRESS:-}" ]]; then
    : "${SEPOLIA_RPC_URL:?SEPOLIA_RPC_URL is required when BRIDGEHUB_ADDRESS is set}"
    command -v cast >/dev/null || {
      echo "cast is required for Bridgehub collision checks" >&2
      exit 1
    }
    registered=$(cast call "$BRIDGEHUB_ADDRESS" "getZKChain(uint256)(address)" "$candidate" --rpc-url "$SEPOLIA_RPC_URL")
    if [[ "$registered" != "0x0000000000000000000000000000000000000000" ]]; then
      continue
    fi
  fi

  echo "$candidate"
  exit 0
done

echo "Unable to find an unused high 31-bit chain ID after 100 attempts" >&2
exit 1
