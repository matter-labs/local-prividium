#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
export LC_ALL=C

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
encrypted_file="${SANDBOX_SECRETS_FILE:-${repo_root}/deployment/secrets/sandbox.enc.env}"
targets_file="${FUNDING_TARGETS_FILE:-${repo_root}/deployment/funding-targets.json}"
public_manifest="${PUBLIC_MANIFEST_PATH:-${repo_root}/deployment/public/manifest.json}"
role_report="${ROLE_REPORT_PATH:-${repo_root}/deployment/public/roles.md}"
chainlist_url="${CHAINLIST_URL:-https://chainid.network/chains.json}"
from_environment="false"

if [[ "${1:-}" == "--from-environment" ]]; then
  from_environment="true"
  shift
fi
if (( $# )); then
  echo "Usage: tools/preflight" >&2
  exit 1
fi

if [[ "$from_environment" != "true" ]]; then
  command -v sops >/dev/null || {
    echo "sops is required to verify the encrypted sandbox configuration" >&2
    exit 1
  }
  if [[ ! -s "$encrypted_file" ]]; then
    echo "Encrypted sandbox configuration not found: ${encrypted_file}" >&2
    echo "Run: ./cli/prividium init" >&2
    exit 1
  fi
  export PRIVIDIUM_PREFLIGHT_SCRIPT="${BASH_SOURCE[0]}"
  exec sops exec-env "$encrypted_file" \
    'exec "$PRIVIDIUM_PREFLIGHT_SCRIPT" --from-environment'
fi

source "${repo_root}/tools/lib/sandbox-roles.sh"
source "${repo_root}/tools/lib/funding-targets.sh"

runtime_tmp=""
chainlist_tmp=""
browser_options_headers_tmp=""
browser_headers_tmp=""
browser_body_tmp=""
rpc_error_tmp=""
funding_output_tmp=""
compose_validation_tmp=""
background_pids=()
dns_result_files=()
registry_result_files=()

cleanup() {
  local pid
  local temporary
  if (( ${#background_pids[@]} )); then
    for pid in "${background_pids[@]}"; do
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    done
  fi
  for temporary in \
    "$runtime_tmp" \
    "$chainlist_tmp" \
    "$browser_options_headers_tmp" \
    "$browser_headers_tmp" \
    "$browser_body_tmp" \
    "$rpc_error_tmp" \
    "$funding_output_tmp" \
    "$compose_validation_tmp"; do
    if [[ -n "$temporary" ]]; then
      rm -f -- "$temporary"
    fi
  done
  if (( ${#dns_result_files[@]} )); then
    for temporary in "${dns_result_files[@]}"; do
      rm -f -- "$temporary"
    done
  fi
  if (( ${#registry_result_files[@]} )); then
    for temporary in "${registry_result_files[@]}"; do
      rm -f -- "$temporary"
    done
  fi
}
trap cleanup EXIT

runtime_tmp=$(mktemp)
chainlist_tmp=$(mktemp)
browser_options_headers_tmp=$(mktemp)
browser_headers_tmp=$(mktemp)
browser_body_tmp=$(mktemp)
rpc_error_tmp=$(mktemp)
funding_output_tmp=$(mktemp)
compose_validation_tmp=$(mktemp)
chmod 0600 \
  "$runtime_tmp" \
  "$chainlist_tmp" \
  "$browser_options_headers_tmp" \
  "$browser_headers_tmp" \
  "$browser_body_tmp" \
  "$rpc_error_tmp" \
  "$funding_output_tmp" \
  "$compose_validation_tmp"

action_items=()
blocking_items=()
warning_items=()

pass_check() {
  printf "✓ %s\n" "$1"
}

action_check() {
  printf "✗ %s\n" "$1"
  action_items+=("$2")
}

block_check() {
  printf "✗ %s\n" "$1"
  blocking_items+=("$2")
}

warn_check() {
  printf "! %s\n" "$1"
  warning_items+=("$2")
}

skip_check() {
  printf "– %s\n" "$1"
}

print_numbered_items() {
  local index=1
  local item
  for item in "$@"; do
    printf "%d. %s\n" "$index" "$item"
    index=$((index + 1))
  done
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

http_header_value() {
  local file="$1"
  local header="$2"
  awk -v wanted="$header" '
    tolower($1) == tolower(wanted ":") {
      $1 = ""
      sub(/^[[:space:]]+/, "")
      gsub(/\r/, "")
      sub(/[[:space:]]+$/, "")
      print
    }
  ' "$file" | tail -n 1
}

header_allows_token() {
  local value
  local token="$2"
  value=$(printf "%s" "$1" | tr '[:upper:]' '[:lower:]')
  if [[ "$value" == "*" ]]; then
    return 0
  fi
  printf "%s" "$value" |
    tr ',' '\n' |
    awk '{$1=$1; print}' |
    grep -Fxq "$token"
}

printf "Prividium sandbox preflight\n"
printf "Profile: sandbox\n"
printf "Scope: evaluation preparation\n\n"

printf "Configuration\n"
pass_check "Encrypted configuration decrypts with the configured age identity"
encrypted_mode=$(file_mode "$encrypted_file")
if (( (8#$encrypted_mode & 0022) == 0 )); then
  pass_check "Encrypted configuration is not group/world writable"
else
  block_check \
    "Encrypted configuration is group/world writable (mode ${encrypted_mode})" \
    "Restrict ${encrypted_file} so only its owner can modify it."
fi

required_config=(
  SANDBOX_DOMAIN
  ACME_EMAIL
  L2_CHAIN_ID
  RUNTIME_DIR
  SEPOLIA_RPC_URL
  SEPOLIA_BROWSER_RPC_URL
  BRIDGE_SPONSOR_KEYSTORE_B64
  BRIDGE_SPONSOR_KEYSTORE_PASSWORD
  AUTH_SERVER_ADMIN_PRIVATE_KEY
  AUTH_SERVER_ADMIN_ADDRESS
)
missing_config=()
for variable in "${required_config[@]}"; do
  if [[ -z "${!variable:-}" ]]; then
    missing_config+=("$variable")
  fi
done
if (( ${#missing_config[@]} )); then
  block_check \
    "Encrypted configuration is missing required fields" \
    "Reinitialize or repair the encrypted configuration; missing: ${missing_config[*]}."
else
  pass_check "Required sandbox configuration fields are present"
fi

if [[ -n "${SEPOLIA_RPC_URL:-}" &&
      -n "${SEPOLIA_BROWSER_RPC_URL:-}" ]]; then
  private_rpc_comparison="${SEPOLIA_RPC_URL%/}"
  browser_rpc_comparison="${SEPOLIA_BROWSER_RPC_URL%/}"
  if [[ "$private_rpc_comparison" == "$browser_rpc_comparison" ]]; then
    block_check \
      "Private and browser RPC URLs are the same" \
      "Configure a separate public, CORS-enabled SEPOLIA_BROWSER_RPC_URL so private provider credentials cannot enter browser configuration."
  else
    pass_check "Private and browser RPC URLs are separate"
  fi
fi

missing_tools=()
for required_command in age age-keygen cast curl docker jq openssl sops; do
  if ! command -v "$required_command" >/dev/null; then
    missing_tools+=("$required_command")
  fi
done

cast_available="false"
curl_available="false"
docker_available="false"
jq_available="false"
openssl_available="false"
if command -v cast >/dev/null 2>&1; then
  cast_available="true"
fi
if command -v curl >/dev/null 2>&1; then
  curl_available="true"
fi
if command -v docker >/dev/null 2>&1; then
  docker_available="true"
fi
if command -v jq >/dev/null 2>&1; then
  jq_available="true"
fi
if command -v openssl >/dev/null 2>&1; then
  openssl_available="true"
fi

identity_valid="false"
if [[ "$cast_available" == "true" && "$openssl_available" == "true" ]]; then
  if sandbox_load_role_addresses >/dev/null 2>&1 &&
     sandbox_validate_distinct_roles >/dev/null 2>&1; then
    identity_valid="true"
    pass_check "Generated sandbox identities are valid and distinct"
  else
    block_check \
      "Generated sandbox identities are missing, invalid, or reused" \
      "Repair the encrypted identity set before continuing."
  fi

  if [[ -n "${AUTH_SERVER_ADMIN_PRIVATE_KEY:-}" &&
        -n "${AUTH_SERVER_ADMIN_ADDRESS:-}" ]]; then
    if derived_admin_address=$(
      sandbox_private_key_address "$AUTH_SERVER_ADMIN_PRIVATE_KEY" 2>/dev/null
    ); then
      derived_admin_lower=$(
        printf "%s" "$derived_admin_address" | sandbox_lowercase
      )
      configured_admin_lower=$(
        printf "%s" "$AUTH_SERVER_ADMIN_ADDRESS" | sandbox_lowercase
      )
      if [[ "$derived_admin_lower" == "$configured_admin_lower" ]]; then
        pass_check "Auth-server administrator address matches its private key"
      else
        block_check \
          "Auth-server administrator address does not match its private key" \
          "Repair AUTH_SERVER_ADMIN_ADDRESS before continuing."
      fi
    else
      block_check \
        "Auth-server administrator address does not match its private key" \
        "Repair AUTH_SERVER_ADMIN_ADDRESS before continuing."
    fi
  fi
fi

if [[ "$identity_valid" == "true" ]]; then
  if [[ -s "$role_report" ]]; then
    current_fingerprint=$(sandbox_role_fingerprint)
    report_fingerprint=$(
      sed -n 's/.*Role-set fingerprint: `\([^`]*\)`.*/\1/p' "$role_report" |
        head -n 1
    )
    if [[ "$current_fingerprint" == "$report_fingerprint" ]]; then
      pass_check "Public role inventory matches the encrypted identity set"
    else
      block_check \
        "Public role inventory does not match the encrypted identity set" \
        "Resolve the role-inventory mismatch before continuing."
    fi
  else
    block_check \
      "Public role inventory is missing" \
      "Start from a fresh ./cli/prividium init identity set before continuing."
  fi
fi

l2_chain_id_valid="false"
if [[ "${L2_CHAIN_ID:-}" =~ ^[0-9]{10}$ &&
      "$L2_CHAIN_ID" > "1073741823" &&
      "$L2_CHAIN_ID" < "2147483648" ]]; then
  l2_chain_id_valid="true"
  pass_check "L2 chain ID ${L2_CHAIN_ID} is in the required high 31-bit range"
else
  block_check \
    "L2 chain ID is outside the required high 31-bit range" \
    "Use an L2 chain ID in the range 1073741824..2147483647."
fi

if [[ -e "$public_manifest" || -L "$public_manifest" ]]; then
  manifest_conflict="true"
  block_check \
    "A public protocol manifest already exists" \
    "Use ./cli/prividium deploy for an already-broadcast sandbox."
else
  manifest_conflict="false"
  pass_check "No conflicting public protocol manifest exists"
fi

if [[ "$jq_available" == "true" ]]; then
  if sandbox_validate_funding_targets "$targets_file" >/dev/null 2>&1; then
    pass_check "Evaluation funding targets use the exact six-role Sepolia schema"
  else
    block_check \
      "Evaluation funding targets are invalid" \
      "Restore deployment/funding-targets.json from the approved repository checkout."
  fi
fi

if sops --decrypt --input-type dotenv --output-type dotenv \
  "$encrypted_file" >"$runtime_tmp" 2>/dev/null; then
  chmod 0600 "$runtime_tmp"
  pass_check "Temporary Compose input was protected and will be removed"
  runtime_renderable="true"
else
  runtime_renderable="false"
  block_check \
    "Encrypted configuration could not be rendered for Compose validation" \
    "Verify the age identity and encrypted configuration."
fi

printf "\nHost\n"
if (( ${#missing_tools[@]} )); then
  action_check \
    "Required host tools are missing: ${missing_tools[*]}" \
    "Install the missing host tools: ${missing_tools[*]}."
else
  pass_check "Required host tools are available"
fi

host_system=$(uname -s)
host_architecture=$(uname -m)
if [[ "$host_system" == "Linux" &&
      ( "$host_architecture" == "x86_64" || "$host_architecture" == "amd64" ) ]]; then
  pass_check "Deployment host is Linux / amd64"
else
  action_check \
    "Deployment host is ${host_system} / ${host_architecture}; Linux / amd64 is required" \
    "Run the sandbox deployment from a Linux / amd64 host."
fi

docker_cli_ready="false"
if [[ "$docker_available" == "true" ]]; then
  if docker compose version >/dev/null 2>&1; then
    pass_check "Docker Compose v2 is available"
    docker_cli_ready="true"
  else
    action_check \
      "Docker Compose v2 is unavailable" \
      "Install Docker Compose v2."
  fi
  if DOCKER_CLIENT_TIMEOUT=15 docker info >/dev/null 2>&1; then
    pass_check "Docker daemon is reachable"
  else
    action_check \
      "Docker daemon is not reachable by the current user" \
      "Start Docker and grant the deployment user access to its daemon."
  fi
fi

if [[ ! -x "${repo_root}/tools/validate-stack" ]]; then
  block_check \
    "Checked-in Compose validation helper is missing or not executable" \
    "Restore tools/validate-stack from the approved repository checkout."
elif [[ "$runtime_renderable" == "true" &&
      "$docker_cli_ready" == "true" &&
      "$jq_available" == "true" ]]; then
  if FUNDING_TARGETS_FILE="$targets_file" \
    "${repo_root}/tools/validate-stack" \
    "$runtime_tmp" >"$compose_validation_tmp" 2>&1; then
    pass_check "Complete Compose model passes static validation"
  else
    compose_validation_detail=$(tail -n 1 "$compose_validation_tmp")
    case "$compose_validation_detail" in
      Funding\ targets*|Compose\ module*|Root\ Compose*|Legacy\ monolithic*|\
      Demo\ services*|docker-compose-*|Rendered\ Compose*|Optional\ service*|\
      Unpinned\ remote*|Unexpected\ published*|Grafana*|The\ core\ Keycloak*|\
      OIDC_ADMIN_SUBS*|Unpinned\ Dockerfile*|A\ public\ Markdown*)
        compose_validation_label="Generated core Compose model failed: ${compose_validation_detail}"
        ;;
      *)
        compose_validation_label="Generated core Compose model failed static validation"
        ;;
    esac
    block_check \
      "$compose_validation_label" \
      "Repair the generated configuration or checked-in Compose model."
  fi
fi

printf "\nNetwork\n"
rpc_probe_available="false"
if [[ -s "${repo_root}/dev/chain-bootstrap/rpc-capabilities.sh" ]]; then
  rpc_probe_available="true"
else
  block_check \
    "Checked-in private-RPC capability probe is missing" \
    "Restore dev/chain-bootstrap/rpc-capabilities.sh from the approved repository checkout."
fi

private_rpc_ready="false"
if [[ "$cast_available" == "true" && -n "${SEPOLIA_RPC_URL:-}" ]]; then
  if actual_l1_chain_id=$(
    ETH_RPC_URL="$SEPOLIA_RPC_URL" \
      ETH_RPC_TIMEOUT=15 \
      cast chain-id 2>/dev/null
  ); then
    if [[ "$actual_l1_chain_id" == "11155111" ]]; then
      private_rpc_ready="true"
      pass_check "Private RPC is Ethereum Sepolia (URL hidden)"
    else
      block_check \
        "Private RPC returned chain ID ${actual_l1_chain_id}; expected Sepolia" \
        "Configure SEPOLIA_RPC_URL for Ethereum Sepolia (11155111)."
    fi
  else
    action_check \
      "Private Sepolia RPC is unreachable" \
      "Restore private Sepolia RPC connectivity and credentials."
  fi
fi

if [[ "$private_rpc_ready" == "true" && "$rpc_probe_available" == "true" ]]; then
  source "${repo_root}/dev/chain-bootstrap/rpc-capabilities.sh"
  if ETH_RPC_TIMEOUT=15 \
    probe_sepolia_rpc_capabilities "$SEPOLIA_RPC_URL" 2>"$rpc_error_tmp"; then
    pass_check "Private RPC supports history, logs, receipts, and blob fee data"
  else
    action_check \
      "Private RPC capability probe failed" \
      "Use a Sepolia RPC with historical calls/logs, receipts, and EIP-4844 blob fee data."
  fi
fi

if [[ "$curl_available" == "true" &&
      "$jq_available" == "true" &&
      -n "${SEPOLIA_BROWSER_RPC_URL:-}" &&
      -n "${SANDBOX_DOMAIN:-}" ]]; then
  browser_origin="https://app.${SANDBOX_DOMAIN}"
  browser_options_ready="false"
  if curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --max-time 15 \
    --request OPTIONS \
    --header "Origin: ${browser_origin}" \
    --header "Access-Control-Request-Method: POST" \
    --header "Access-Control-Request-Headers: content-type" \
    --dump-header "$browser_options_headers_tmp" \
    --output /dev/null \
    "$SEPOLIA_BROWSER_RPC_URL" 2>/dev/null; then
    options_cors_origin=$(
      http_header_value "$browser_options_headers_tmp" "access-control-allow-origin"
    )
    options_cors_methods=$(
      http_header_value "$browser_options_headers_tmp" "access-control-allow-methods"
    )
    options_cors_headers=$(
      http_header_value "$browser_options_headers_tmp" "access-control-allow-headers"
    )
    if [[ "$options_cors_origin" == "*" ||
          "$options_cors_origin" == "$browser_origin" ]] &&
       header_allows_token "$options_cors_methods" "post" &&
       header_allows_token "$options_cors_headers" "content-type"; then
      browser_options_ready="true"
    else
      action_check \
        "Browser RPC CORS preflight does not allow POST with content-type" \
        "Allow Origin ${browser_origin}, method POST, and header content-type on SEPOLIA_BROWSER_RPC_URL."
    fi
  else
    action_check \
      "Browser RPC rejects the required CORS OPTIONS request" \
      "Enable browser CORS preflight requests on SEPOLIA_BROWSER_RPC_URL."
  fi

  if [[ "$browser_options_ready" == "true" ]] && curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --max-time 15 \
    --request POST \
    --header "Content-Type: application/json" \
    --header "Origin: ${browser_origin}" \
    --data '{"jsonrpc":"2.0","method":"eth_chainId","params":[],"id":1}' \
    --dump-header "$browser_headers_tmp" \
    --output "$browser_body_tmp" \
    "$SEPOLIA_BROWSER_RPC_URL" 2>/dev/null; then
    browser_chain_id=$(jq -r '.result // empty' "$browser_body_tmp" 2>/dev/null || true)
    browser_cors_origin=$(http_header_value "$browser_headers_tmp" "access-control-allow-origin")
    if [[ "$(printf "%s" "$browser_chain_id" | sandbox_lowercase)" != "0xaa36a7" ]]; then
      block_check \
        "Browser RPC is not Ethereum Sepolia" \
        "Configure SEPOLIA_BROWSER_RPC_URL for Ethereum Sepolia (11155111)."
    elif [[ "$browser_cors_origin" == "*" ||
            "$browser_cors_origin" == "$browser_origin" ]]; then
      pass_check "Browser RPC is Sepolia and permits the sandbox origin (URL hidden)"
    else
      action_check \
        "Browser RPC does not permit the sandbox browser origin" \
        "Allow Origin ${browser_origin} on SEPOLIA_BROWSER_RPC_URL."
    fi
  elif [[ "$browser_options_ready" == "true" ]]; then
    action_check \
      "Browser Sepolia RPC is unreachable from this host" \
      "Restore the public browser RPC and its CORS configuration."
  fi
fi

if [[ "$l2_chain_id_valid" == "true" &&
      -n "${L2_CHAIN_ID:-}" &&
      -n "$chainlist_url" &&
      "$curl_available" == "true" &&
      "$jq_available" == "true" ]]; then
  if curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --max-time 20 \
    "$chainlist_url" \
    --output "$chainlist_tmp" 2>/dev/null; then
    if jq -e --argjson id "$L2_CHAIN_ID" \
      'any(.[]; .chainId == $id)' "$chainlist_tmp" >/dev/null 2>&1; then
      block_check \
        "L2 chain ID ${L2_CHAIN_ID} is already listed in Chainlist" \
        "Choose a new sandbox identity set before any protocol preparation or broadcast."
    elif jq -e 'type == "array"' "$chainlist_tmp" >/dev/null 2>&1; then
      pass_check "L2 chain ID ${L2_CHAIN_ID} is not listed in Chainlist"
    else
      action_check \
        "Chainlist returned an invalid collision-check response" \
        "Retry the Chainlist collision check."
    fi
  else
    action_check \
      "Chainlist is unreachable for the L2 chain-ID collision check" \
      "Restore access to chainid.network and rerun preflight."
  fi
fi

if [[ "$docker_available" == "true" ]]; then
  private_images=()
  while IFS= read -r image; do
    private_images+=("$image")
  done < <(
    awk '
      $1 == "permissions_api:" ||
      $1 == "user_panel:" ||
      $1 == "admin_panel:" {
        print $2
      }
    ' "${repo_root}/deployment/versions.lock.yaml"
  )
  if (( ${#private_images[@]} != 3 )); then
    block_check \
      "Core private image locks are incomplete" \
      "Restore the three pinned Prividium image references in deployment/versions.lock.yaml."
  else
    failed_private_images=()
    background_pids=()
    for image in "${private_images[@]}"; do
      registry_result_tmp=$(mktemp)
      registry_result_files+=("$registry_result_tmp")
      (
        if DOCKER_CLIENT_TIMEOUT=20 \
          docker manifest inspect "$image" >/dev/null 2>&1; then
          printf "accessible\t%s\n" "$image"
        else
          printf "inaccessible\t%s\n" "$image"
        fi
      ) >"$registry_result_tmp" &
      background_pids+=("$!")
    done
    for pid in "${background_pids[@]}"; do
      wait "$pid" || true
    done
    background_pids=()
    for registry_result_tmp in "${registry_result_files[@]}"; do
      IFS=$'\t' read -r registry_result image <"$registry_result_tmp" || true
      if [[ "$registry_result" != "accessible" ]]; then
        failed_private_images+=("${image:-unknown image}")
      fi
    done
    if (( ${#failed_private_images[@]} == 0 )); then
      pass_check "Core private Prividium image metadata is accessible"
    else
      action_check \
        "Private image metadata is inaccessible: ${failed_private_images[*]}" \
        "Authenticate Docker to quay.io with access to the Prividium images."
    fi
  fi
fi

dns_resolved=0
dns_total=6
if [[ -n "${SANDBOX_DOMAIN:-}" ]]; then
  unresolved_hostnames=()
  background_pids=()
  for label in app admin api explorer explorer-api idp; do
    hostname="${label}.${SANDBOX_DOMAIN}"
    dns_result_tmp=$(mktemp)
    dns_result_files+=("$dns_result_tmp")
    (
      if command -v getent >/dev/null 2>&1 &&
         RES_OPTIONS="attempts:1 timeout:2" \
           getent ahosts "$hostname" >/dev/null 2>&1; then
        printf "resolved\t%s\n" "$hostname"
      elif command -v dscacheutil >/dev/null 2>&1 &&
           dscacheutil -q host -a name "$hostname" |
             grep -q ip_address; then
        printf "resolved\t%s\n" "$hostname"
      elif command -v host >/dev/null 2>&1 &&
           host -W 3 "$hostname" >/dev/null 2>&1; then
        printf "resolved\t%s\n" "$hostname"
      else
        printf "unresolved\t%s\n" "$hostname"
      fi
    ) >"$dns_result_tmp" &
    background_pids+=("$!")
  done
  for pid in "${background_pids[@]}"; do
    wait "$pid" || true
  done
  background_pids=()
  for dns_result_tmp in "${dns_result_files[@]}"; do
    IFS=$'\t' read -r dns_result hostname <"$dns_result_tmp" || true
    if [[ "$dns_result" == "resolved" ]]; then
      dns_resolved=$((dns_resolved + 1))
    else
      unresolved_hostnames+=("${hostname:-unknown hostname}")
    fi
  done
  if (( dns_resolved == dns_total )); then
    pass_check "All six core sandbox hostnames resolve"
  else
    warn_check \
      "${dns_resolved}/${dns_total} core sandbox hostnames resolve; unresolved: ${unresolved_hostnames[*]}" \
      "Complete and independently verify sandbox DNS before browser evaluation."
  fi
fi

printf "\nFunding\n"
if [[ "$manifest_conflict" != "true" &&
      "$private_rpc_ready" == "true" &&
      "$identity_valid" == "true" &&
      "$jq_available" == "true" ]]; then
  funding_status=0
  if FUNDING_TARGETS_FILE="$targets_file" \
    PUBLIC_MANIFEST_PATH="$public_manifest" \
    ETH_RPC_TIMEOUT=15 \
    "${repo_root}/tools/funding-reconcile" \
      --from-environment --check all \
      >"$funding_output_tmp" 2>&1; then
    pass_check "All six deployment and operator identities are at their evaluation targets"
    pass_check "Sandbox funding wallet has no pending transaction"
  else
    funding_status=$?
    if [[ "$funding_status" == "2" ]]; then
      if grep -Fq "Retry after RPC connectivity is restored" "$funding_output_tmp"; then
        action_check \
          "Live Sepolia funding balances could not be read" \
          "Restore private Sepolia RPC connectivity, then rerun ./cli/prividium preflight."
      elif grep -Fq "pending Sepolia transaction" "$funding_output_tmp"; then
        action_check \
          "Sandbox funding wallet has a pending Sepolia transaction" \
          "Wait for the pending transaction to settle, then rerun ./cli/prividium preflight."
      elif grep -Fq "role(s) remain below" "$funding_output_tmp"; then
        action_check \
          "One or more deployment or operator identities are below target" \
          "Run ./cli/prividium fund to reconcile the remaining role balances."
      else
        action_check \
          "Sandbox funding state changed or still needs attention" \
          "Run ./cli/prividium fund and follow its reported next action."
      fi
    else
      block_check \
        "Role funding could not be validated safely" \
        "Run ./cli/prividium fund and resolve its reported blocker before continuing."
    fi
  fi
else
  skip_check "Role funding was not checked because an earlier prerequisite failed"
fi

printf "\nEvaluation boundary\n"
printf "• Single-host Sepolia sandbox using fake proofs and a testnet verifier\n"
printf "• SOPS-managed hot keys intended only for assets without value\n"
printf "• Optional profiles receive static validation but are not activated or runtime-checked\n"
printf "• Host preflight reports the recommended 8 vCPU, 16 GB RAM, and nominal 200 GB SSD without blocking\n"
printf "• Passing preflight is not production or protocol-broadcast approval\n"

printf "\n"
if (( ${#blocking_items[@]} )); then
  printf "PREFLIGHT BLOCKED\n\n"
  print_numbered_items "${blocking_items[@]}"
  if (( ${#action_items[@]} )); then
    printf "\nAdditional actions\n\n"
    print_numbered_items "${action_items[@]}"
  fi
  printf "\nNo transactions were submitted. No persistent configuration was changed.\n"
  exit 1
fi

if (( ${#action_items[@]} )); then
  printf "ACTION REQUIRED\n\n"
  print_numbered_items "${action_items[@]}"
  printf "\nThen rerun: ./cli/prividium preflight\n"
  printf "No transactions were submitted. No persistent configuration was changed.\n"
  exit 2
fi

if (( ${#warning_items[@]} )); then
  printf "PREFLIGHT PASSED WITH WARNINGS\n\n"
  print_numbered_items "${warning_items[@]}"
else
  printf "PREFLIGHT PASSED\n"
fi
printf "\nNo transactions were submitted. No persistent configuration was changed.\n"
printf "Next:\n"
printf '%s\n' '  sudo install -d -m 0700 -o "$USER" /etc/prividium/runtime'
printf "  ./cli/prividium prepare\n"
