#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
environment_file="${1:-/etc/prividium/runtime/sandbox.env}"
if [[ ! -s "$environment_file" ]]; then
  echo "Runtime environment not found: ${environment_file}" >&2
  exit 1
fi

set -a
# The file is generated by tools/init-secrets and contains only shell-safe dotenv values.
source "$environment_file"
set +a

: "${SANDBOX_DOMAIN:?SANDBOX_DOMAIN is required}"
: "${L2_CHAIN_ID:?L2_CHAIN_ID is required}"
: "${CHAIN_NAME:?CHAIN_NAME is required}"
: "${RUNTIME_DIR:?RUNTIME_DIR is required}"

if [[ ! "$SANDBOX_DOMAIN" =~ ^[a-z0-9][a-z0-9.-]+[a-z0-9]$ ]]; then
  echo "SANDBOX_DOMAIN is not safe for template rendering" >&2
  exit 1
fi
if [[ ! "$L2_CHAIN_ID" =~ ^[0-9]+$ ]]; then
  echo "L2_CHAIN_ID must be numeric" >&2
  exit 1
fi
if [[ ! "$CHAIN_NAME" =~ ^[A-Za-z0-9._\ -]+$ ]]; then
  echo "CHAIN_NAME contains unsupported characters" >&2
  exit 1
fi

mkdir -p "$RUNTIME_DIR"
sed \
  -e "s/__SANDBOX_DOMAIN__/${SANDBOX_DOMAIN}/g" \
  -e "s/__L2_CHAIN_ID__/${L2_CHAIN_ID}/g" \
  -e "s/__CHAIN_NAME__/${CHAIN_NAME}/g" \
  "${repo_root}/dev/block-explorer/block-explorer-config.template.js" \
  >"${RUNTIME_DIR}/block-explorer-config.js"
chmod 0600 "${RUNTIME_DIR}/block-explorer-config.js"

echo "Rendered browser runtime configuration in ${RUNTIME_DIR}"
