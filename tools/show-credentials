#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
encrypted="${1:-${repo_root}/deployment/secrets/sandbox.enc.env}"

[[ -t 0 && -t 1 ]] || {
  echo "Credential reveal requires an interactive terminal and refuses redirected output" >&2
  exit 1
}

if [[ "${1:-}" != "--from-environment" ]]; then
  command -v sops >/dev/null || {
    echo "sops is required" >&2
    exit 1
  }
  [[ -s "$encrypted" ]] || {
    echo "Encrypted sandbox environment not found: ${encrypted}" >&2
    exit 1
  }
  export PRIVIDIUM_SHOW_CREDENTIALS_SCRIPT="${BASH_SOURCE[0]}"
  exec sops exec-env "$encrypted" \
    'exec "$PRIVIDIUM_SHOW_CREDENTIALS_SCRIPT" --from-environment'
fi

required=(
  SANDBOX_DOMAIN SANDBOX_ADMIN_EMAIL SANDBOX_ADMIN_PASSWORD
  SANDBOX_USER_1_EMAIL SANDBOX_USER_1_PASSWORD
  SANDBOX_USER_2_EMAIL SANDBOX_USER_2_PASSWORD
)
for name in "${required[@]}"; do
  [[ -n "${!name:-}" ]] || {
    echo "Encrypted configuration is missing ${name}" >&2
    exit 1
  }
done

printf '\nPrividium evaluation credentials\n\n'
printf 'User application: https://app.%s\n' "$SANDBOX_DOMAIN"
printf 'Administration:   https://admin.%s\n\n' "$SANDBOX_DOMAIN"
printf '%-28s %-34s %s\n' EMAIL PASSWORD ROLE
printf '%-28s %-34s %s\n' \
  "$SANDBOX_ADMIN_EMAIL" "$SANDBOX_ADMIN_PASSWORD" 'administrator; change at first sign-in'
printf '%-28s %-34s %s\n' \
  "$SANDBOX_USER_1_EMAIL" "$SANDBOX_USER_1_PASSWORD" user
printf '%-28s %-34s %s\n' \
  "$SANDBOX_USER_2_EMAIL" "$SANDBOX_USER_2_PASSWORD" user
printf '\nClose or clear this terminal when finished.\n'
