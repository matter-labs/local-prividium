#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${repo_root}/tools/lib/sandbox-roles.sh"

export SANDBOX_ADMIN_EMAIL="${SANDBOX_ADMIN_EMAIL:-admin@local.dev}"
export SANDBOX_ADMIN_PASSWORD="${SANDBOX_ADMIN_PASSWORD:-password}"
export SANDBOX_USER_1_EMAIL="${SANDBOX_USER_1_EMAIL:-user1@local.dev}"
export SANDBOX_USER_1_PASSWORD="${SANDBOX_USER_1_PASSWORD:-password}"
export SANDBOX_USER_2_EMAIL="${SANDBOX_USER_2_EMAIL:-user2@local.dev}"
export SANDBOX_USER_2_PASSWORD="${SANDBOX_USER_2_PASSWORD:-password}"

required_environment=(
  SANDBOX_DOMAIN ACME_EMAIL SANDBOX_ADMIN_EMAIL
  SEPOLIA_RPC_URL SEPOLIA_BROWSER_RPC_URL
  SOPS_AGE_RECIPIENT
)
for name in "${required_environment[@]}"; do
  if [[ -z "${!name:-}" ]]; then
    echo "Set ${name} before running tools/init-secrets" >&2
    exit 1
  fi
done
for command in cast openssl sops; do
  command -v "$command" >/dev/null || {
    echo "${command} is required" >&2
    exit 1
  }
done

sandbox_domain_is_valid() {
  local domain="$1"
  local label
  local label_count=0
  local remaining="$1"

  if (( ${#domain} > 253 )) ||
     [[ "$domain" != *.* || "$domain" == *..* ]]; then
    return 1
  fi

  while :; do
    if [[ "$remaining" == *.* ]]; then
      label="${remaining%%.*}"
      remaining="${remaining#*.}"
    else
      label="$remaining"
      remaining=""
    fi
    if (( ${#label} < 1 || ${#label} > 63 )) ||
       [[ ! "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
      return 1
    fi
    label_count=$((label_count + 1))
    [[ -n "$remaining" ]] || break
  done

  (( label_count >= 2 ))
}

if ! sandbox_domain_is_valid "$SANDBOX_DOMAIN"; then
  echo "SANDBOX_DOMAIN must be a valid lower-case DNS name with labels no longer than 63 characters" >&2
  exit 1
fi
email_pattern='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$'
for user_email_name in ACME_EMAIL SANDBOX_ADMIN_EMAIL SANDBOX_USER_1_EMAIL SANDBOX_USER_2_EMAIL; do
  user_email="${!user_email_name}"
  if [[ ! "$user_email" =~ $email_pattern ]]; then
    echo "${user_email_name} is invalid" >&2
    exit 1
  fi
done
admin_email_normalized=$(printf '%s' "$SANDBOX_ADMIN_EMAIL" | tr '[:upper:]' '[:lower:]')
user_1_email_normalized=$(printf '%s' "$SANDBOX_USER_1_EMAIL" | tr '[:upper:]' '[:lower:]')
user_2_email_normalized=$(printf '%s' "$SANDBOX_USER_2_EMAIL" | tr '[:upper:]' '[:lower:]')
if [[ "$admin_email_normalized" == "$user_1_email_normalized" ||
      "$admin_email_normalized" == "$user_2_email_normalized" ||
      "$user_1_email_normalized" == "$user_2_email_normalized" ]]; then
  echo "Sandbox evaluation-user emails must be distinct" >&2
  exit 1
fi
password_pattern='^[A-Za-z0-9._%+@,/:=!?^-]+$'
for password_name in \
  SANDBOX_ADMIN_PASSWORD SANDBOX_USER_1_PASSWORD SANDBOX_USER_2_PASSWORD; do
  user_password="${!password_name}"
  if [[ ! "$user_password" =~ $password_pattern ]]; then
    echo "${password_name} may use letters, numbers, and ._%+@,/:=!?^- only" >&2
    exit 1
  fi
done
rpc_url_pattern='^https://[A-Za-z0-9:/?&=._%+-]+$'
for rpc_url in "$SEPOLIA_RPC_URL" "$SEPOLIA_BROWSER_RPC_URL"; do
  if [[ ! "$rpc_url" =~ $rpc_url_pattern ]]; then
    echo "Sepolia RPC URLs must use HTTPS and contain only URL-safe characters" >&2
    exit 1
  fi
done
private_rpc_comparison="${SEPOLIA_RPC_URL%/}"
browser_rpc_comparison="${SEPOLIA_BROWSER_RPC_URL%/}"
if [[ "$private_rpc_comparison" == "$browser_rpc_comparison" ]]; then
  echo "Private and browser RPC URLs must be separate" >&2
  exit 1
fi
output="${SECRETS_OUTPUT:-${repo_root}/deployment/secrets/sandbox.enc.env}"
if [[ ( -e "$output" || -L "$output" ) && "${OVERWRITE_SECRETS:-false}" != "true" ]]; then
  echo "${output} already exists; set OVERWRITE_SECRETS=true to replace it" >&2
  exit 1
fi

random_hex() {
  openssl rand -hex "${1:-32}"
}
private_key() {
  echo "0x$(random_hex 32)"
}

plaintext=""
encrypted_output=""
published_output=""
signer_dir=""
signer_keystore=""
cleanup() {
  local status=$?
  if [[ -n "$plaintext" ]]; then
    rm -f -- "$plaintext"
  fi
  if [[ -n "$encrypted_output" ]]; then
    rm -f -- "$encrypted_output"
  fi
  if [[ -n "$signer_keystore" ]]; then
    rm -f -- "$signer_keystore"
  fi
  if [[ -n "$signer_dir" ]]; then
    rmdir "$signer_dir" 2>/dev/null || true
  fi
  if (( status != 0 )) && [[ -n "$published_output" ]]; then
    rm -f -- "$published_output"
    echo "Initialization did not complete; removed the incomplete encrypted configuration." >&2
  fi
}
trap cleanup EXIT

l2_chain_id=$("${repo_root}/tools/generate-chain-id")
l1_deployer_key=$(private_key)
ecosystem_governor_key=$(private_key)
chain_owner_key=$(private_key)
fee_account_key=$(private_key)
operator_commit_key=$(private_key)
operator_prove_key=$(private_key)
operator_execute_key=$(private_key)
signer_dir=$(mktemp -d)
chmod 0700 "$signer_dir"
signer_keystore="${signer_dir}/sponsor"
bridge_sponsor_keystore_password=$(random_hex 32)
if ! CAST_PASSWORD="$bridge_sponsor_keystore_password" \
  cast wallet new "$signer_dir" sponsor >/dev/null 2>&1; then
  echo "Could not generate the encrypted Sandbox funding-wallet signer" >&2
  exit 1
fi
if [[ ! -s "$signer_keystore" ]]; then
  echo "Cast did not create the Sandbox funding-wallet keystore" >&2
  exit 1
fi
chmod 0600 "$signer_keystore"
bridge_sponsor_key=$(
  CAST_UNSAFE_PASSWORD="$bridge_sponsor_keystore_password" \
    cast wallet decrypt-keystore sponsor --keystore-dir "$signer_dir" 2>/dev/null |
    grep -Eo '0x[0-9a-fA-F]{64}' |
    head -n 1
) || true
if [[ ! "$bridge_sponsor_key" =~ ^0x[0-9a-fA-F]{64}$ ]]; then
  echo "Could not recover the Sandbox funding-wallet key from its keystore" >&2
  exit 1
fi
bridge_sponsor_keystore_b64=$(openssl base64 -A <"$signer_keystore")
if [[ -z "$bridge_sponsor_keystore_b64" ]]; then
  echo "Could not encode the Sandbox funding-wallet keystore" >&2
  exit 1
fi
bundler_key=$(private_key)
entrypoint_key=$(private_key)
sso_deployer_key=$(private_key)
auth_server_key=$(private_key)
auth_server_admin_key=$(private_key)
auth_server_admin_address=$(sandbox_private_key_address "$auth_server_admin_key")
demo_deployer_key=$(private_key)

plaintext=$(mktemp)
cat >"$plaintext" <<EOF
SANDBOX_DOMAIN=${SANDBOX_DOMAIN}
ACME_EMAIL=${ACME_EMAIL}
SANDBOX_ADMIN_EMAIL=${SANDBOX_ADMIN_EMAIL}
CHAIN_NAME="Prividium Sandbox"
L2_CHAIN_ID=${l2_chain_id}
L1_CHAIN_ID=11155111
ETH_PRICE_USD=3000
RUNTIME_DIR=/etc/prividium/runtime
SEPOLIA_RPC_URL="${SEPOLIA_RPC_URL}"
SEPOLIA_BROWSER_RPC_URL="${SEPOLIA_BROWSER_RPC_URL}"
L1_DEPLOYER_PRIVATE_KEY=${l1_deployer_key}
ECOSYSTEM_GOVERNOR_PRIVATE_KEY=${ecosystem_governor_key}
CHAIN_OWNER_PRIVATE_KEY=${chain_owner_key}
FEE_ACCOUNT_PRIVATE_KEY=${fee_account_key}
OPERATOR_COMMIT_PRIVATE_KEY=${operator_commit_key}
OPERATOR_PROVE_PRIVATE_KEY=${operator_prove_key}
OPERATOR_EXECUTE_PRIVATE_KEY=${operator_execute_key}
OPERATOR_MIN_L1_BALANCE_WEI=10000000000000000
DEPLOYMENT_SIGNER_MIN_L1_BALANCE_WEI=10000000000000000
BRIDGE_SPONSOR_PRIVATE_KEY=${bridge_sponsor_key}
BRIDGE_SPONSOR_KEYSTORE_B64=${bridge_sponsor_keystore_b64}
BRIDGE_SPONSOR_KEYSTORE_PASSWORD=${bridge_sponsor_keystore_password}
BUNDLER_ENABLED=false
BUNDLER_PRIVATE_KEY=${bundler_key}
ENTRYPOINT_DEPLOYER_PRIVATE_KEY=${entrypoint_key}
SSO_DEPLOYER_PRIVATE_KEY=${sso_deployer_key}
AUTH_SERVER_PRIVATE_KEY=${auth_server_key}
AUTH_SERVER_ADMIN_PRIVATE_KEY=${auth_server_admin_key}
AUTH_SERVER_ADMIN_ADDRESS=${auth_server_admin_address}
INSTITUTIONAL_DEMO_DEPLOYER_PRIVATE_KEY=${demo_deployer_key}
SERVICE_WALLET_TARGET_L2_ETH=0.05
FACTORY_DEPLOYER_FUNDING_ETH=0.012
POSTGRES_SUPERUSER_PASSWORD=$(random_hex 24)
PRIVIDIUM_DB_NAME=prividium_api
PRIVIDIUM_DB_USER=prividium
PRIVIDIUM_DB_PASSWORD=$(random_hex 24)
EXPLORER_DB_NAME=prividium_block_explorer
EXPLORER_DB_USER=explorer
EXPLORER_DB_PASSWORD=$(random_hex 24)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=$(random_hex 24)
WEBHOOK_DB_NAME=zksync_webhook_db
WEBHOOK_DB_USER=webhook
WEBHOOK_DB_PASSWORD=$(random_hex 24)
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kcadmin-$(random_hex 4)
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=$(random_hex 24)
SANDBOX_ADMIN_PASSWORD=${SANDBOX_ADMIN_PASSWORD}
SANDBOX_USER_1_EMAIL=${SANDBOX_USER_1_EMAIL}
SANDBOX_USER_1_PASSWORD=${SANDBOX_USER_1_PASSWORD}
SANDBOX_USER_2_EMAIL=${SANDBOX_USER_2_EMAIL}
SANDBOX_USER_2_PASSWORD=${SANDBOX_USER_2_PASSWORD}
SIWE_HMAC_SECRET=$(random_hex 32)
EXPLORER_SESSION_SECRET=$(random_hex 32)
WEBHOOK_ENCRYPTION_KEY=$(random_hex 32)
WEBHOOK_ENCRYPTION_KDF_SALT=$(random_hex 24)
WEBHOOK_PRIVIDIUM_API_KEY=priv_sk_$(random_hex 32)
WEBHOOK_ENABLED=false
GRAFANA_ADMIN_USER=sandbox-admin
GRAFANA_ADMIN_PASSWORD=$(random_hex 24)
REOWN_PROJECT_ID=${REOWN_PROJECT_ID:-}
DEMO_USER_1_EMAIL=${DEMO_USER_1_EMAIL:-demo-admin@${SANDBOX_DOMAIN}}
DEMO_USER_1_PASSWORD=$(random_hex 24)
DEMO_USER_2_EMAIL=${DEMO_USER_2_EMAIL:-demo-member@${SANDBOX_DOMAIN}}
DEMO_USER_2_PASSWORD=$(random_hex 24)
EOF

mkdir -p "$(dirname "$output")"
encrypted_output=$(mktemp "${output}.tmp.XXXXXX")
sops --age "$SOPS_AGE_RECIPIENT" \
  --input-type dotenv \
  --output-type dotenv \
  --encrypt "$plaintext" >"$encrypted_output"
chmod 0600 "$encrypted_output"
if [[ "${OVERWRITE_SECRETS:-false}" == "true" ]]; then
  mv "$encrypted_output" "$output"
else
  if ! ln "$encrypted_output" "$output" 2>/dev/null; then
    echo "${output} appeared during initialization; refusing to replace it" >&2
    exit 1
  fi
  published_output="$output"
  rm -f "$encrypted_output"
fi
encrypted_output=""

echo "✓ Generated encrypted sandbox configuration"
echo "✓ Generated L2 chain ID: ${l2_chain_id}"
SANDBOX_SECRETS_FILE="$output" "${repo_root}/tools/role-report"
published_output=""
