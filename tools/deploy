#!/usr/bin/env bash
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
compose_file="${repo_root}/compose/compose.yaml"
environment_file="${SANDBOX_ENV_FILE:-/etc/prividium/runtime/sandbox.env}"
public_manifest="${repo_root}/deployment/public/manifest.json"
expected_protocol_commit="e091691063c99a1d0281d6fe42fb0ec4430f3673"
expected_deployer_commit="16c6a83b4f634609958f347c56549ba19bf9df9b"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

if [[ ! -s "$environment_file" ]]; then
  echo "Runtime environment not found: ${environment_file}" >&2
  echo "Run: ./cli/prividium prepare" >&2
  exit 1
fi
if [[ -L "$public_manifest" || ! -f "$public_manifest" || ! -s "$public_manifest" ]]; then
  echo "Public chain manifest not found: ${public_manifest}" >&2
  echo "Run ./cli/prividium prepare and ./cli/prividium broadcast before deployment." >&2
  exit 1
fi

set -a
source "$environment_file"
set +a
unset PRIVIDIUM_CHAIN_BOOTSTRAP_IMAGE
: "${L2_CHAIN_ID:?L2_CHAIN_ID is missing from the runtime environment}"
: "${RUNTIME_DIR:?RUNTIME_DIR is missing from the runtime environment}"
if [[ "$RUNTIME_DIR" != "/etc/prividium/runtime" ]]; then
  echo "Runtime directory must be /etc/prividium/runtime; found ${RUNTIME_DIR}" >&2
  exit 1
fi
runtime_dir="$RUNTIME_DIR"
runtime_artifacts=(
  "${runtime_dir}/chain/server.yaml"
  "${runtime_dir}/chain/sandbox-overrides.yaml"
  "${runtime_dir}/chain/genesis.json"
  "${runtime_dir}/chain/state.json"
  "${runtime_dir}/chain/out/manifest.json"
  "${runtime_dir}/chain/out/preparation.json"
)
for artifact in "${runtime_artifacts[@]}"; do
  if [[ -L "$artifact" || ! -f "$artifact" || ! -s "$artifact" || ! -r "$artifact" ]]; then
    echo "Chain runtime artifact is missing or unsafe: ${artifact}" >&2
    echo "The broadcast did not complete; do not start the stack." >&2
    exit 1
  fi
done

genesis_sha=$(sha256_file "${runtime_dir}/chain/genesis.json")
if ! jq -e \
  --argjson chain_id "$L2_CHAIN_ID" \
  --arg protocol "$expected_protocol_commit" \
  --arg deployer "$expected_deployer_commit" \
  --arg genesis_sha "$genesis_sha" \
  '
    .environment == "sandbox" and
    .l1_chain_id == 11155111 and
    .l2_chain_id == $chain_id and
    .protocol_version == "0.31.0" and
    .sources.protocol == $protocol and
    .sources.zk_deployer == $deployer and
    .genesis.sha256 == $genesis_sha and
    .security.proofs == "fake" and
    .security.verifier == "testnet" and
    .security.production_safe == false
  ' "$public_manifest" >/dev/null; then
  echo "Public manifest does not match the protected sandbox runtime" >&2
  exit 1
fi
if ! jq -e \
  --argjson chain_id "$L2_CHAIN_ID" \
  --arg protocol "$expected_protocol_commit" \
  --arg deployer "$expected_deployer_commit" \
  '
    .schema_version == 1 and
    .l1_chain_id == 11155111 and
    .l2_chain_id == $chain_id and
    .sources.protocol == $protocol and
    .sources.zk_deployer == $deployer and
    (.chain_bootstrap_image_id |
      type == "string" and
      test("^sha256:[0-9a-f]{64}$"))
  ' "${runtime_dir}/chain/out/preparation.json" >/dev/null; then
  echo "Protocol preparation provenance does not match the protected runtime" >&2
  exit 1
fi
prepared_image_id=$(
  jq -r '.chain_bootstrap_image_id' \
    "${runtime_dir}/chain/out/preparation.json"
)
if ! docker image inspect "$prepared_image_id" >/dev/null 2>&1; then
  echo "The exact chain-bootstrap image used during preparation is missing." >&2
  echo "Rerun ./cli/prividium prepare before deployment." >&2
  exit 1
fi

cd "$repo_root"
printf "\n[1/4] Rendering browser configuration\n"
"${repo_root}/tools/render-runtime" "$environment_file"
printf "\n[2/4] Validating the complete deployment model\n"
"${repo_root}/tools/validate-stack" "$environment_file"
missing_images=()
while IFS= read -r image; do
  [[ -n "$image" ]] || continue
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    missing_images+=("$image")
  fi
done < <(
  PRIVIDIUM_CHAIN_BOOTSTRAP_IMAGE="$prepared_image_id" \
    docker compose -f "$compose_file" \
      --env-file "$environment_file" config --images |
    sort -u
)
if (( ${#missing_images[@]} )); then
  echo "One or more prepared default images are missing locally:" >&2
  printf "  %s\n" "${missing_images[@]}" >&2
  echo "Rerun ./cli/prividium prepare before deployment." >&2
  exit 1
fi
printf "\n[3/4] Starting the prebuilt core sandbox\n"
PRIVIDIUM_CHAIN_BOOTSTRAP_IMAGE="$prepared_image_id" \
  docker compose -f "$compose_file" --env-file "$environment_file" \
    up -d --no-build --pull never
printf "\nCurrent service state:\n\n"
docker compose -f "$compose_file" --env-file "$environment_file" ps
printf "\n[4/4] Waiting for services and validating public interfaces\n"
SANDBOX_ENV_FILE="$environment_file" "${repo_root}/tools/deployment-summary"
printf "\nCore sandbox is healthy. Review deployment/public/deployment-summary.md.\n"
