#!/usr/bin/env bash
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
environment_file="${SANDBOX_ENV_FILE:-/etc/prividium/runtime/sandbox.env}"
public_manifest="${repo_root}/deployment/public/manifest.json"

if [[ ! -s "$environment_file" ]]; then
  echo "Runtime environment not found: ${environment_file}" >&2
  echo "Run: tools/sandbox decrypt" >&2
  exit 1
fi
if [[ ! -s "$public_manifest" ]]; then
  echo "Public chain manifest not found: ${public_manifest}" >&2
  echo "Run tools/sandbox prepare and tools/sandbox broadcast before deployment." >&2
  exit 1
fi

set -a
source "$environment_file"
set +a
: "${L2_CHAIN_ID:?L2_CHAIN_ID is missing from the runtime environment}"
: "${RUNTIME_DIR:?RUNTIME_DIR is missing from the runtime environment}"
runtime_dir="$RUNTIME_DIR"
if [[ "$runtime_dir" != /* ]]; then
  runtime_dir="${repo_root}/${runtime_dir}"
fi
for required_file in server.yaml sandbox-overrides.yaml genesis.json; do
  if [[ ! -s "${runtime_dir}/chain/${required_file}" ]]; then
    echo "Chain runtime file is missing: ${runtime_dir}/chain/${required_file}" >&2
    echo "The broadcast did not complete; do not start the stack." >&2
    exit 1
  fi
done
manifest_chain_id=$(jq -r '.l2_chain_id // empty' "$public_manifest")
if [[ "$manifest_chain_id" != "$L2_CHAIN_ID" ]]; then
  echo "Runtime chain ID ${L2_CHAIN_ID} does not match public manifest ${manifest_chain_id}" >&2
  exit 1
fi

cd "$repo_root"
printf "\n[1/5] Rendering browser configuration\n"
"${repo_root}/tools/render-runtime" "$environment_file"
printf "\n[2/5] Validating the complete deployment model\n"
"${repo_root}/tools/validate-stack" "$environment_file"
printf "\n[3/5] Building locally maintained images\n"
docker compose --env-file "$environment_file" build
printf "\n[4/5] Starting the core sandbox\n"
docker compose --env-file "$environment_file" up -d
printf "\nCurrent service state:\n\n"
docker compose --env-file "$environment_file" ps
printf "\n[5/5] Waiting for services and validating public interfaces\n"
SANDBOX_ENV_FILE="$environment_file" "${repo_root}/tools/deployment-summary"
printf "\nCore sandbox is healthy. Review deployment/public/deployment-summary.md.\n"
