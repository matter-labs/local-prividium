#!/usr/bin/env python3
"""Exercise non-admin OIDC login and the protected Prividium RPC."""

from __future__ import annotations

import argparse
import base64
from dataclasses import dataclass
import hashlib
from html.parser import HTMLParser
import http.cookiejar
import json
import os
import secrets
import sys
import time
from typing import Any, NoReturn
import urllib.error
import urllib.parse
import urllib.request


def fail(message: str) -> NoReturn:
    print(f"Error: {message}", file=sys.stderr)
    raise SystemExit(1)


def required(name: str) -> str:
    value = os.environ.get(name, "").strip()
    if not value:
        fail(f"{name} is required")
    return value


def base64url(value: bytes) -> str:
    return base64.urlsafe_b64encode(value).rstrip(b"=").decode()


class LoginFormParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.action = ""
        self.fields: dict[str, str] = {}
        self._in_form = False

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        values = dict(attrs)
        if tag == "form" and not self.action:
            action = values.get("action")
            if action:
                self.action = action
                self._in_form = True
        elif tag == "input" and self._in_form:
            name = values.get("name")
            if name:
                self.fields[name] = values.get("value") or ""

    def handle_endtag(self, tag: str) -> None:
        if tag == "form" and self._in_form:
            self._in_form = False


class CallbackRedirect(urllib.request.HTTPRedirectHandler):
    def __init__(self, callback_prefix: str) -> None:
        self.callback_prefix = callback_prefix
        self.callback_url = ""

    def redirect_request(
        self,
        req: urllib.request.Request,
        fp: Any,
        code: int,
        msg: str,
        headers: Any,
        newurl: str,
    ) -> urllib.request.Request | None:
        if newurl.startswith(self.callback_prefix):
            self.callback_url = newurl
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


@dataclass
class Session:
    access_token: str
    issued_at: float


class ProductSmoke:
    def __init__(self) -> None:
        self.domain = required("SANDBOX_DOMAIN")
        self.username = required("SANDBOX_USER_1_EMAIL")
        self.password = required("SANDBOX_USER_1_PASSWORD")
        try:
            self.chain_id = int(required("L2_CHAIN_ID"))
        except ValueError:
            fail("L2_CHAIN_ID must be numeric")
        self.issuer = f"https://idp.{self.domain}/realms/prividium"
        self.rpc_url = f"https://api.{self.domain}/rpc"
        self.redirect_uri = f"https://app.{self.domain}/callback"
        self.client_id = "prividium-client"
        self.session: Session | None = None

    @staticmethod
    def request(opener: Any, request: urllib.request.Request, timeout: int = 20) -> bytes:
        request.add_header("User-Agent", "prividium-happy-path/1")
        with opener.open(request, timeout=timeout) as response:
            return response.read()

    def login(self) -> Session:
        verifier = base64url(secrets.token_bytes(48))
        challenge = base64url(hashlib.sha256(verifier.encode()).digest())
        state = base64url(secrets.token_bytes(24))
        nonce = base64url(secrets.token_bytes(24))
        callback_redirect = CallbackRedirect(self.redirect_uri)
        opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()),
            callback_redirect,
        )
        authorization_query = urllib.parse.urlencode(
            {
                "client_id": self.client_id,
                "redirect_uri": self.redirect_uri,
                "response_type": "code",
                "scope": "openid",
                "state": state,
                "nonce": nonce,
                "code_challenge": challenge,
                "code_challenge_method": "S256",
            }
        )
        authorization_url = f"{self.issuer}/protocol/openid-connect/auth?{authorization_query}"
        try:
            login_html = self.request(opener, urllib.request.Request(authorization_url)).decode("utf-8")
        except (OSError, UnicodeError, urllib.error.URLError) as error:
            fail(f"OIDC authorization endpoint is unavailable: {error}")

        parser = LoginFormParser()
        parser.feed(login_html)
        if not parser.action:
            fail("OIDC authorization endpoint did not return a login form")
        parser.fields.update(
            {
                "username": self.username,
                "password": self.password,
                "credentialId": "",
            }
        )
        login_request = urllib.request.Request(
            parser.action,
            data=urllib.parse.urlencode(parser.fields).encode(),
            method="POST",
        )
        login_request.add_header("Content-Type", "application/x-www-form-urlencoded")
        try:
            self.request(opener, login_request)
        except urllib.error.HTTPError as error:
            location = error.headers.get("Location", "")
            if error.code not in {301, 302, 303, 307, 308} or not location.startswith(self.redirect_uri):
                fail(f"non-admin OIDC login failed with HTTP {error.code}")
            callback_redirect.callback_url = location
        except urllib.error.URLError as error:
            fail(f"non-admin OIDC login failed: {error}")

        callback_url = callback_redirect.callback_url
        if not callback_url:
            fail("non-admin OIDC login did not reach the approved callback")
        callback_values = urllib.parse.parse_qs(urllib.parse.urlparse(callback_url).query)
        if callback_values.get("state", [""])[0] != state:
            fail("OIDC callback state did not match the authorization request")
        authorization_code = callback_values.get("code", [""])[0]
        if not authorization_code:
            fail("OIDC callback did not contain an authorization code")

        token_request = urllib.request.Request(
            f"{self.issuer}/protocol/openid-connect/token",
            data=urllib.parse.urlencode(
                {
                    "grant_type": "authorization_code",
                    "client_id": self.client_id,
                    "redirect_uri": self.redirect_uri,
                    "code": authorization_code,
                    "code_verifier": verifier,
                }
            ).encode(),
            method="POST",
        )
        token_request.add_header("Content-Type", "application/x-www-form-urlencoded")
        try:
            token_response = json.loads(self.request(urllib.request.build_opener(), token_request))
        except (OSError, ValueError, urllib.error.URLError) as error:
            fail(f"OIDC token exchange failed: {error}")
        access_token = token_response.get("access_token")
        if not isinstance(access_token, str) or not access_token:
            fail("OIDC token exchange returned no access token")
        try:
            payload_segment = access_token.split(".")[1]
            payload_segment += "=" * (-len(payload_segment) % 4)
            claims = json.loads(base64.urlsafe_b64decode(payload_segment))
        except (IndexError, ValueError, json.JSONDecodeError) as error:
            fail(f"OIDC access token payload is invalid: {error}")
        roles = claims.get("realm_access", {}).get("roles", [])
        if "user" not in roles or "admin" in roles:
            fail("OIDC smoke identity is not a non-admin user")
        if claims.get("preferred_username", "").lower() != self.username.lower():
            fail("OIDC access token identifies the wrong evaluation user")
        session = Session(
            access_token=access_token,
            issued_at=time.monotonic(),
        )
        self.session = session
        return session

    def rpc(self, method: str, params: list[Any]) -> Any:
        if self.session is None or time.monotonic() - self.session.issued_at > 600:
            self.login()
        assert self.session is not None
        body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
        request = urllib.request.Request(self.rpc_url, data=body, method="POST")
        request.add_header("Content-Type", "application/json")
        request.add_header("Authorization", f"Bearer {self.session.access_token}")
        try:
            response = json.loads(self.request(urllib.request.build_opener(), request))
        except urllib.error.HTTPError as error:
            if error.code == 401:
                self.login()
                return self.rpc(method, params)
            fail(f"protected RPC returned HTTP {error.code}")
        except (OSError, ValueError, urllib.error.URLError) as error:
            fail(f"protected RPC request failed: {error}")
        if response.get("error") is not None:
            fail(f"protected RPC returned an error for {method}")
        return response.get("result")

    def verify_chain(self) -> None:
        chain_result = self.rpc("eth_chainId", [])
        try:
            actual_chain_id = int(chain_result, 16)
        except (TypeError, ValueError):
            fail("protected RPC returned an invalid eth_chainId result")
        if actual_chain_id != self.chain_id:
            fail(f"protected RPC chain ID {actual_chain_id} does not match {self.chain_id}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--wait-receipt", metavar="L2_TX_HASH")
    parser.add_argument("--timeout", type=int, default=600)
    args = parser.parse_args()
    if args.timeout < 1 or args.timeout > 3600:
        fail("--timeout must be between 1 and 3600 seconds")
    if args.wait_receipt and not (
        len(args.wait_receipt) == 66 and args.wait_receipt.startswith("0x")
    ):
        fail("--wait-receipt requires a 32-byte transaction hash")

    smoke = ProductSmoke()
    smoke.verify_chain()
    result: dict[str, Any] = {
        "authenticated_rpc": True,
        "l2_chain_id": smoke.chain_id,
        "non_admin": True,
    }
    if args.wait_receipt:
        deadline = time.monotonic() + args.timeout
        last_report = 0.0
        while True:
            receipt = smoke.rpc("eth_getTransactionReceipt", [args.wait_receipt])
            if receipt is not None:
                if receipt.get("status") != "0x1":
                    fail("canary L2 receipt reports failure")
                result.update(
                    {
                        "l2_transaction_hash": args.wait_receipt,
                        "l2_receipt_status": "success",
                    }
                )
                break
            now = time.monotonic()
            if now >= deadline:
                fail("timed out waiting for the canary L2 receipt")
            if now - last_report >= 30:
                print("Waiting for the authenticated canary receipt...", file=sys.stderr)
                last_report = now
            time.sleep(10)
    print(json.dumps(result, separators=(",", ":"), sort_keys=True))


if __name__ == "__main__":
    main()
