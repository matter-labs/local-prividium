#!/usr/bin/env bash
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
runtime_environment="${SANDBOX_ENV_FILE:-/etc/prividium/runtime/sandbox.env}"
encrypted_environment="${SANDBOX_SECRETS_FILE:-${repo_root}/deployment/secrets/sandbox.enc.env}"
failures=0

pass() {
  printf "  [ok]   %s\n" "$1"
}

warn() {
  printf "  [warn] %s\n" "$1"
}

fail() {
  printf "  [fail] %s\n" "$1"
  failures=$((failures + 1))
}

printf "Sandbox setup doctor\n\n"
printf "Required tools\n"
for command in docker sops age cast jq openssl curl; do
  if command -v "$command" >/dev/null; then
    pass "$command"
  else
    fail "$command is not installed"
  fi
done

if command -v docker >/dev/null; then
  if docker compose version >/dev/null 2>&1; then
    pass "Docker Compose v2"
  else
    fail "Docker Compose v2 is unavailable"
  fi
  if docker info >/dev/null 2>&1; then
    pass "Docker daemon is reachable"
  else
    fail "Docker daemon is not reachable by the current user"
  fi
fi

printf "\nHost\n"
architecture=$(uname -m)
if [[ "$architecture" == "x86_64" || "$architecture" == "amd64" ]]; then
  pass "amd64 host architecture"
else
  warn "host architecture is ${architecture}; the deployment target must be amd64"
fi

printf "\nConfiguration\n"
source "${repo_root}/tools/lib/funding-policy.sh"
if sandbox_validate_funding_policy "${repo_root}/deployment/funding-policy.json" >/dev/null 2>&1; then
  pass "release-benchmarked one-ETH funding policy"
else
  fail "funding policy is not release-ready; see docs/FUNDING_BENCHMARK.md"
fi

if [[ -s "$encrypted_environment" ]]; then
  pass "encrypted secrets: ${encrypted_environment}"
else
  warn "encrypted secrets do not exist yet; run tools/sandbox init"
fi

if [[ -s "$runtime_environment" ]]; then
  pass "decrypted runtime environment: ${runtime_environment}"
  if "${repo_root}/tools/validate-stack" \
    --allow-unbenchmarked "$runtime_environment" >/dev/null 2>&1; then
    pass "rendered Compose configuration"
  else
    fail "rendered Compose validation failed; run tools/sandbox validate for details"
  fi
else
  warn "runtime environment does not exist yet; run tools/sandbox decrypt"
fi

if [[ -s "${repo_root}/deployment/public/manifest.json" ]]; then
  pass "public chain deployment manifest"
else
  warn "chain has not been broadcast yet (deployment/public/manifest.json is absent)"
fi

if (( failures )); then
  printf "\nDoctor found %d blocking issue(s).\n" "$failures"
  exit 1
fi

printf "\nNo blocking local setup issues found.\n"
