#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
encrypted_file="${1:-${SANDBOX_SECRETS_FILE:-${repo_root}/deployment/secrets/sandbox.enc.env}}"
output="${ROLE_REPORT_PATH:-${repo_root}/deployment/public/roles.md}"

if [[ "${1:-}" != "--from-environment" ]]; then
  command -v sops >/dev/null || {
    echo "sops is required to generate the role inventory" >&2
    exit 1
  }
  if [[ ! -s "$encrypted_file" ]]; then
    echo "Encrypted sandbox environment not found: ${encrypted_file}" >&2
    exit 1
  fi
  export PRIVIDIUM_ROLE_REPORT_SCRIPT="${BASH_SOURCE[0]}"
  export ROLE_REPORT_PATH="$output"
  exec sops exec-env "$encrypted_file" \
    'exec "$PRIVIDIUM_ROLE_REPORT_SCRIPT" --from-environment'
fi

source "${repo_root}/tools/lib/sandbox-roles.sh"

: "${SANDBOX_DOMAIN:?SANDBOX_DOMAIN is missing from the encrypted environment}"
: "${L2_CHAIN_ID:?L2_CHAIN_ID is missing from the encrypted environment}"
command -v cast >/dev/null || {
  echo "cast is required to derive public role addresses" >&2
  exit 1
}

sandbox_validate_distinct_roles
fingerprint=$(sandbox_role_fingerprint)
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT

write_role_row() {
  local role="$1"
  local address
  address=$(sandbox_role_address "$role")
  printf '| %s | `%s` | %s | %s |\n' \
    "$(sandbox_role_label "$role")" \
    "$address" \
    "$(sandbox_role_scope "$role")" \
    "$(sandbox_role_purpose "$role")" \
    >>"$temporary"
}

{
  echo "# Prividium sandbox role inventory"
  echo
  echo "This non-secret inventory explains every generated sandbox identity. Private keys remain only in the SOPS-encrypted environment."
  echo
  echo "- Sandbox domain: \`${SANDBOX_DOMAIN}\`"
  echo "- Ethereum settlement network: Sepolia (\`11155111\`)"
  echo "- L2 chain ID: \`${L2_CHAIN_ID}\`"
  echo "- Role-set fingerprint: \`${fingerprint}\`"
  echo
  echo "## 1. Chain deployment and governance"
  echo
  echo "| Role | Address | Scope | Purpose |"
  echo "| --- | --- | --- | --- |"
} >"$temporary"
for role in l1_deployer ecosystem_governor chain_owner; do
  write_role_row "$role"
done

{
  echo
  echo "These accounts receive Sepolia ETH automatically from the sandbox funding wallet before broadcast."
  echo
  echo "## 2. Settlement operators"
  echo
  echo "| Role | Address | Scope | Purpose |"
  echo "| --- | --- | --- | --- |"
} >>"$temporary"
for role in operator_commit operator_prove operator_execute; do
  write_role_row "$role"
done

{
  echo
  echo "The core funding policy gives these operators a 14-day evaluation runway."
  echo
  echo "## 3. Sandbox funding"
  echo
  echo "| Role | Address | Scope | Purpose |"
  echo "| --- | --- | --- | --- |"
} >>"$temporary"
write_role_row bridge_sponsor

{
  echo
  echo "> Customer action: send exactly **1 Sepolia ETH** to the sandbox funding wallet. Do not fund the other role addresses manually."
  echo
  echo "## 4. Service and passive accounts"
  echo
  echo "| Role | Address | Scope | Purpose |"
  echo "| --- | --- | --- | --- |"
} >>"$temporary"
for role in fee_account watchdog bundler entrypoint_deployer sso_deployer auth_server auth_server_admin institutional_demo_deployer; do
  write_role_row "$role"
done

{
  echo
  echo "Optional identities remain dormant until their Compose profile is enabled and are not covered by the core 1 ETH funding guarantee."
  echo
  echo "## Security boundary"
  echo
  echo "These are SOPS-managed hot keys for a Sepolia sandbox. They are not a production custody model and must never secure assets of value."
} >>"$temporary"

mkdir -p "$(dirname "$output")"
install -m 0644 "$temporary" "$output"
echo "Public role inventory written to ${output}"
