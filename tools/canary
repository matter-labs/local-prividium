#!/usr/bin/env bash
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
compose_file="${repo_root}/compose/compose.yaml"
environment_file="${SANDBOX_ENV_FILE:-/etc/prividium/runtime/sandbox.env}"
confirmation="${CONFIRM_CANARY:-}"

if [[ ! -s "$environment_file" ]]; then
  echo "Runtime environment not found: ${environment_file}" >&2
  exit 1
fi
set -a
source "$environment_file"
set +a
unset PRIVIDIUM_CHAIN_BOOTSTRAP_IMAGE
: "${L2_CHAIN_ID:?L2_CHAIN_ID is missing from the runtime environment}"
: "${RUNTIME_DIR:?RUNTIME_DIR is missing from the runtime environment}"
if [[ "$RUNTIME_DIR" != "/etc/prividium/runtime" ]]; then
  echo "Runtime directory must be /etc/prividium/runtime; found ${RUNTIME_DIR}" >&2
  exit 1
fi
expected="CANARY_SEPOLIA_${L2_CHAIN_ID}"
if [[ "$confirmation" != "$expected" ]]; then
  echo "Set CONFIRM_CANARY=${expected} to authorize the Sepolia canary" >&2
  exit 1
fi

preparation_record="${RUNTIME_DIR}/chain/out/preparation.json"
prepared_image_id=$(
  jq -er --argjson chain_id "$L2_CHAIN_ID" '
    select(
      .l1_chain_id == 11155111 and
      .l2_chain_id == $chain_id and
      .data_availability_mode == "no_da" and
      .transaction_filterer.enabled == true and
      .transaction_filterer.deposits_allowed == true
    ) |
    .chain_bootstrap_image_id |
    select(test("^sha256:[0-9a-f]{64}$"))
  ' \
    "$preparation_record"
)
docker image inspect "$prepared_image_id" >/dev/null
export PRIVIDIUM_CHAIN_BOOTSTRAP_IMAGE="$prepared_image_id"

sensitive_values=(
  "$SEPOLIA_RPC_URL"
  "$BRIDGE_SPONSOR_PRIVATE_KEY"
  "${BRIDGE_SPONSOR_PRIVATE_KEY#0x}"
)
sanitize_output() {
  local line
  local sensitive
  while IFS= read -r line || [[ -n "$line" ]]; do
    for sensitive in "${sensitive_values[@]}"; do
      [[ -z "$sensitive" ]] || line="${line//$sensitive/[hidden]}"
    done
    printf '%s\n' "$line"
  done
}

cd "$repo_root"
docker compose -f "$compose_file" \
  --env-file "$environment_file" --profile chain-bootstrap run \
  --rm --no-build --pull never \
  --entrypoint /usr/local/bin/prividium-canary \
  -e "CONFIRM_CANARY=${confirmation}" \
  chain-bootstrap 2>&1 | sanitize_output
