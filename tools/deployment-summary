#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
compose_file="${repo_root}/compose/compose.yaml"
environment_file="${SANDBOX_ENV_FILE:-/etc/prividium/runtime/sandbox.env}"
public_manifest="${PUBLIC_MANIFEST_PATH:-${repo_root}/deployment/public/manifest.json}"
public_summary="${DEPLOYMENT_SUMMARY_PATH:-${repo_root}/deployment/public/deployment-summary.md}"
versions_lock="${repo_root}/deployment/versions.lock.yaml"

if [[ ! -s "$environment_file" ]]; then
  echo "Runtime environment not found: ${environment_file}" >&2
  exit 1
fi
set -a
source "$environment_file"
set +a

: "${SANDBOX_DOMAIN:?SANDBOX_DOMAIN is missing from the runtime environment}"
: "${L2_CHAIN_ID:?L2_CHAIN_ID is missing from the runtime environment}"
: "${RUNTIME_DIR:?RUNTIME_DIR is missing from the runtime environment}"
runtime_dir="$RUNTIME_DIR"
if [[ "$runtime_dir" != /* ]]; then
  runtime_dir="${repo_root}/${runtime_dir}"
fi
incomplete_summary="${INCOMPLETE_SUMMARY_PATH:-${runtime_dir}/reports/deployment-summary.incomplete.md}"
timeout_seconds="${SUMMARY_TIMEOUT_SECONDS:-600}"
poll_seconds="${SUMMARY_POLL_SECONDS:-10}"
deadline=$((SECONDS + timeout_seconds))
passed_checks=()
failed_checks=()

pass_check() {
  passed_checks+=("$1")
}

fail_check() {
  failed_checks+=("$1")
}

locked_product_value() {
  local product="$1"
  local field="$2"
  awk -v product="$product" -v field="$field" '
    $0 == "  " product ":" { found = 1; next }
    found && $0 ~ /^  [a-zA-Z0-9_]+:$/ { exit }
    found && $1 == field ":" { gsub(/"/, "", $2); print $2; exit }
  ' "$versions_lock"
}

if [[ ! -s "$public_manifest" ]]; then
  fail_check "Public deployment manifest is missing"
elif jq -e \
  --argjson chain_id "$L2_CHAIN_ID" \
  '
    .environment == "sandbox" and
    .l1_chain_id == 11155111 and
    .l2_chain_id == $chain_id and
    .protocol_version == "0.31.0" and
    .assets.base_token == "ETH" and
    .assets.protocol_fee_asset == "ETH" and
    .sources.protocol == "e091691063c99a1d0281d6fe42fb0ec4430f3673" and
    .sources.zk_deployer == "16c6a83b4f634609958f347c56549ba19bf9df9b" and
    .security.proofs == "fake" and
    .security.verifier == "testnet" and
    .security.production_safe == false
  ' "$public_manifest" >/dev/null; then
  pass_check "Public chain manifest matches the runtime chain and locked sandbox release"
else
  fail_check "Public chain manifest does not match the runtime chain or locked sandbox release"
fi

long_running_services=(
  zksyncos postgres keycloak prividium-api user-panel admin-panel caddy
  block-explorer-api block-explorer-app block-explorer-worker
  block-explorer-data-fetcher prometheus grafana
  operator-balance-exporter
)
completed_services=(chain-preflight)

check_compose_services() {
  local service
  local container_id
  local state
  local status
  local exit_code
  local health
  local all_ready=true
  local detail=()

  for service in "${long_running_services[@]}"; do
    container_id=$(docker compose -f "$compose_file" \
      --env-file "$environment_file" ps --all -q "$service" 2>/dev/null |
      head -n 1)
    if [[ -z "$container_id" ]]; then
      all_ready=false
      detail+=("${service}=missing")
      continue
    fi
    state=$(docker inspect --format \
      '{{.State.Status}}|{{.State.ExitCode}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
      "$container_id" 2>/dev/null || true)
    IFS='|' read -r status exit_code health <<<"$state"
    if [[ "$status" != "running" || "$exit_code" != "0" ||
          ( "$health" != "none" && "$health" != "healthy" ) ]]; then
      all_ready=false
      detail+=("${service}=${status:-unknown}/${health:-unknown}")
    fi
  done
  for service in "${completed_services[@]}"; do
    container_id=$(docker compose -f "$compose_file" \
      --env-file "$environment_file" ps --all -q "$service" 2>/dev/null |
      head -n 1)
    if [[ -z "$container_id" ]]; then
      all_ready=false
      detail+=("${service}=missing")
      continue
    fi
    state=$(docker inspect --format '{{.State.Status}}|{{.State.ExitCode}}' "$container_id" 2>/dev/null || true)
    IFS='|' read -r status exit_code <<<"$state"
    if [[ "$status" != "exited" || "$exit_code" != "0" ]]; then
      all_ready=false
      detail+=("${service}=${status:-unknown}/exit-${exit_code:-unknown}")
    fi
  done

  compose_failure_detail="${detail[*]:-none}"
  [[ "$all_ready" == "true" ]]
}

if (( ${#failed_checks[@]} == 0 )); then
  if ! command -v docker >/dev/null 2>&1; then
    fail_check "Docker is unavailable for the service readiness check"
  else
    compose_ready=false
    while [[ "$compose_ready" != "true" ]]; do
      if check_compose_services; then
        compose_ready=true
        break
      fi
      if (( SECONDS >= deadline )); then
        fail_check "Core Compose services did not become ready: ${compose_failure_detail}"
        break
      fi
      printf "Waiting for core services: %s\n" "$compose_failure_detail"
      sleep "$poll_seconds"
    done
    if [[ "$compose_ready" == "true" ]]; then
      pass_check "The 14 core Compose services are running and chain-preflight completed successfully"
    fi
  fi
else
  fail_check "Core service checks were not run because the public manifest is invalid"
fi

http_status() {
  curl --silent --show-error --location --connect-timeout 5 --max-time 10 \
    --output /dev/null --write-out '%{http_code}' "$1"
}

endpoint_passes=()
endpoint_failures=()

record_endpoint_result() {
  local label="$1"
  local status="$2"
  local expected="$3"
  if [[ "$status" =~ $expected ]]; then
    endpoint_passes+=("${label} passed HTTPS (${status})")
  else
    endpoint_failures+=("${label} failed HTTPS (${status:-unreachable})")
  fi
}

probe_public_endpoints() {
  local status
  local discovery
  endpoint_passes=()
  endpoint_failures=()

  status=$(http_status "https://app.${SANDBOX_DOMAIN}/" 2>/dev/null || true)
  record_endpoint_result "User application" "$status" '^[23][0-9][0-9]$'
  status=$(http_status "https://admin.${SANDBOX_DOMAIN}/" 2>/dev/null || true)
  record_endpoint_result "Administration application" "$status" '^[23][0-9][0-9]$'
  status=$(http_status "https://explorer.${SANDBOX_DOMAIN}/" 2>/dev/null || true)
  record_endpoint_result "Block Explorer" "$status" '^[23][0-9][0-9]$'
  status=$(http_status "https://explorer-api.${SANDBOX_DOMAIN}/" 2>/dev/null || true)
  record_endpoint_result "Block Explorer API" "$status" '^[1-4][0-9][0-9]$'
  status=$(http_status "https://api.${SANDBOX_DOMAIN}/health" 2>/dev/null || true)
  record_endpoint_result "Prividium API health" "$status" '^2[0-9][0-9]$'
  status=$(
    curl --silent --show-error --connect-timeout 5 --max-time 10 \
      --output /dev/null --write-out '%{http_code}' \
      --header 'Content-Type: application/json' \
      --data '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}' \
      "https://api.${SANDBOX_DOMAIN}/rpc" 2>/dev/null || true
  )
  record_endpoint_result "Unauthenticated protected RPC denial" "$status" '^(401|403)$'

  discovery=$(mktemp)
  if curl --fail --silent --show-error --location --connect-timeout 5 --max-time 10 \
    "https://idp.${SANDBOX_DOMAIN}/realms/prividium/.well-known/openid-configuration" \
    --output "$discovery" 2>/dev/null &&
    jq -e --arg issuer "https://idp.${SANDBOX_DOMAIN}/realms/prividium" \
      '.issuer == $issuer' "$discovery" >/dev/null; then
    endpoint_passes+=("OIDC discovery advertises the expected strict issuer")
  else
    endpoint_failures+=("OIDC discovery is unavailable or advertises the wrong issuer")
  fi
  rm -f "$discovery"
  (( ${#endpoint_failures[@]} == 0 ))
}

if (( ${#failed_checks[@]} == 0 )); then
  if ! command -v curl >/dev/null 2>&1; then
    fail_check "curl is unavailable for public endpoint checks"
  else
    endpoints_ready=false
    while [[ "$endpoints_ready" != "true" ]]; do
      if probe_public_endpoints; then
        endpoints_ready=true
        break
      fi
      if (( SECONDS >= deadline )); then
        break
      fi
      printf "Waiting for public interfaces: %s\n" "${endpoint_failures[*]}"
      sleep "$poll_seconds"
    done
    if [[ "$endpoints_ready" == "true" ]]; then
      for result in "${endpoint_passes[@]}"; do
        pass_check "$result"
      done
    else
      for result in "${endpoint_failures[@]}"; do
        fail_check "$result"
      done
    fi
  fi
else
  fail_check "Public endpoint checks were not run because core service readiness failed"
fi

generated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
report_tmp=$(mktemp)
trap 'rm -f "$report_tmp"' EXIT

write_checks() {
  local item
  echo "## Automated checks"
  echo
  for item in "${passed_checks[@]}"; do
    echo "- [x] ${item}"
  done
  for item in "${failed_checks[@]}"; do
    echo "- [ ] ${item}"
  done
}

if (( ${#failed_checks[@]} )); then
  {
    echo "# Incomplete Prividium sandbox deployment"
    echo
    echo "- Generated: \`${generated_at}\`"
    echo "- Sandbox domain: \`${SANDBOX_DOMAIN}\`"
    echo "- L2 chain ID: \`${L2_CHAIN_ID}\`"
    echo "- Status: **INCOMPLETE**"
    echo
    write_checks
    echo
    echo "Resolve the failed checks, inspect \`docker compose -f compose/compose.yaml --env-file ${environment_file} ps --all\` and \`docker compose -f compose/compose.yaml --env-file ${environment_file} logs\`, then rerun \`./cli/prividium deploy\`."
    echo
    echo "This diagnostic contains no private keys, passwords, or provider URLs."
  } >"$report_tmp"
  mkdir -p "$(dirname "$incomplete_summary")"
  install -m 0600 "$report_tmp" "$incomplete_summary"
  cat "$incomplete_summary"
  echo
  echo "Protected incomplete summary written to ${incomplete_summary}" >&2
  echo "A previously successful public summary, if present, was not changed." >&2
  exit 1
fi

if [[ -s "$incomplete_summary" ]]; then
  rm -f "$incomplete_summary"
fi

service_is_running() {
  local profile="$1"
  local service="$2"
  [[ -n "$(
    docker compose -f "$compose_file" \
      --env-file "$environment_file" --profile "$profile" \
      ps -q "$service" 2>/dev/null || true
  )" ]]
}

sso_enabled=false
webhook_enabled=false
demo_enabled=false
if command -v docker >/dev/null 2>&1; then
  service_is_running sso auth-server && sso_enabled=true
  service_is_running webhook zksync-webhook-service && webhook_enabled=true
  service_is_running institutional-demo institutional-demo && demo_enabled=true
fi

{
  echo "# Prividium sandbox deployment summary"
  echo
  echo "- Generated: \`${generated_at}\`"
  echo "- Status: **HEALTHY**"
  echo "- Ethereum settlement network: Sepolia (\`11155111\`)"
  echo "- L2 chain ID: \`${L2_CHAIN_ID}\`"
  echo "- Chain name: \`${CHAIN_NAME:-Prividium Sandbox}\`"
  echo "- Base token and protocol fee asset: **ETH**"
  echo
  echo "## Public interfaces"
  echo
  echo "| Interface | URL |"
  echo "| --- | --- |"
  echo "| User application | https://app.${SANDBOX_DOMAIN} |"
  echo "| Administration | https://admin.${SANDBOX_DOMAIN} |"
  echo "| Protected API and RPC | https://api.${SANDBOX_DOMAIN} |"
  echo "| Block Explorer | https://explorer.${SANDBOX_DOMAIN} |"
  echo "| Block Explorer API | https://explorer-api.${SANDBOX_DOMAIN} |"
  echo "| OIDC issuer | https://idp.${SANDBOX_DOMAIN}/realms/prividium |"
  if [[ "$sso_enabled" == "true" ]]; then
    echo "| Optional SSO | https://auth.${SANDBOX_DOMAIN} |"
    echo "| Optional SSO API | https://auth-api.${SANDBOX_DOMAIN} |"
  fi
  if [[ "$demo_enabled" == "true" ]]; then
    echo "| Institutional demo | https://demo.${SANDBOX_DOMAIN} |"
  fi
  echo
  echo "## Release"
  echo
  echo "| Component | Version | Locked source |"
  echo "| --- | --- | --- |"
  echo "| Protocol | $(locked_product_value protocol version) | \`$(locked_product_value protocol source_commit)\` |"
  echo "| ZKsync OS server | $(locked_product_value zksync_os_server version) | \`$(locked_product_value zksync_os_server source_commit)\` |"
  echo "| zk-deployer | $(locked_product_value zk_deployer version) | \`$(locked_product_value zk_deployer source_commit)\` |"
  echo "| Prividium | $(locked_product_value prividium version) | \`$(locked_product_value prividium source_commit)\` |"
  echo "| Block Explorer | $(locked_product_value block_explorer version) | \`$(locked_product_value block_explorer source_commit)\` |"
  echo "| Airbender | $(locked_product_value airbender version) — deferred, not running | \`$(locked_product_value airbender source_commit)\` |"
  echo
  echo "## Enabled capabilities"
  echo
  echo "| Capability | State |"
  echo "| --- | --- |"
  echo "| Core Prividium, Explorer, identity, chain, and monitoring | Enabled |"
  echo "| SSO / EntryPoint / bundler | $([[ "$sso_enabled" == "true" ]] && echo Enabled || echo Disabled) |"
  echo "| Webhooks | $([[ "$webhook_enabled" == "true" ]] && echo Enabled || echo Disabled) |"
  echo "| Institutional demo | $([[ "$demo_enabled" == "true" ]] && echo Enabled || echo Disabled) |"
  echo
  echo "## On-chain identity"
  echo
  echo "| Contract | Address |"
  echo "| --- | --- |"
  echo "| Bridgehub | \`$(jq -r '.l1_contracts.bridgehub' "$public_manifest")\` |"
  echo "| Chain Type Manager | \`$(jq -r '.l1_contracts.chain_type_manager' "$public_manifest")\` |"
  echo "| Testnet verifier | \`$(jq -r '.l1_contracts.testnet_verifier' "$public_manifest")\` |"
  echo "| Chain diamond | \`$(jq -r '.chain_contracts.diamond' "$public_manifest")\` |"
  echo "| Chain admin | \`$(jq -r '.chain_contracts.chain_admin' "$public_manifest")\` |"
  echo
  write_checks
  echo
  echo "## Sandbox limitations"
  echo
  echo "- Single VPS with no high availability."
  echo "- Fake FRI and SNARK proofs with a testnet verifier; no production proof security."
  echo "- Sepolia contracts and operator-funded settlement; not an official production network or public testnet."
  echo "- SOPS-managed hot keys; not a production custody design."
  echo "- Do not use this sandbox to secure assets of value."
  echo
  echo "The public API/RPC remains behind Prividium authentication. PostgreSQL, Keycloak administration, Prometheus, bundler, webhook internals, and raw ZKsync OS RPC are not publicly exposed."
} >"$report_tmp"

mkdir -p "$(dirname "$public_summary")"
install -m 0644 "$report_tmp" "$public_summary"
cat "$public_summary"
echo
echo "Commit-safe deployment summary written to ${public_summary}"
