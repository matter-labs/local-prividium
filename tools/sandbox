#!/usr/bin/env bash
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
runtime_environment="${SANDBOX_ENV_FILE:-/etc/prividium/runtime/sandbox.env}"
encrypted_environment="${SANDBOX_SECRETS_FILE:-${repo_root}/deployment/secrets/sandbox.enc.env}"

usage() {
  cat <<'EOF'
Prividium sandbox operator command

Usage:
  tools/sandbox doctor
  tools/sandbox init
  tools/sandbox decrypt
  tools/sandbox edit-secrets
  tools/sandbox roles
  tools/sandbox funding [apply]
  tools/sandbox prepare
  tools/sandbox readiness
  tools/sandbox broadcast
  tools/sandbox deploy
  tools/sandbox summary
  tools/sandbox enable <sso|webhook|demo>
  tools/sandbox status
  tools/sandbox logs [SERVICE...]
  tools/sandbox validate
  tools/sandbox components

Environment overrides:
  SANDBOX_ENV_FILE      Decrypted runtime environment
  SANDBOX_SECRETS_FILE  SOPS-encrypted environment
EOF
}

require_runtime_environment() {
  if [[ ! -s "$runtime_environment" ]]; then
    echo "Runtime environment not found: ${runtime_environment}" >&2
    echo "Run: tools/sandbox decrypt" >&2
    exit 1
  fi
}

environment_value() {
  local name="$1"
  sed -n "s/^${name}=//p" "$runtime_environment" | tail -n 1 | tr -d '"'
}

prompt_value() {
  local name="$1"
  local label="$2"
  local secret="${3:-false}"
  local value="${!name:-}"
  [[ -n "$value" ]] && return
  if [[ ! -t 0 ]]; then
    echo "${name} is required in non-interactive mode" >&2
    exit 1
  fi
  if [[ "$secret" == "true" ]]; then
    read -r -s -p "${label}: " value
    printf "\n"
  else
    read -r -p "${label}: " value
  fi
  if [[ -z "$value" ]]; then
    echo "${name} cannot be empty" >&2
    exit 1
  fi
  printf -v "$name" "%s" "$value"
  export "$name"
}

guided_init() {
  printf "Create a new encrypted sandbox configuration.\n"
  printf "Inputs are used once and written only to the SOPS-encrypted environment.\n\n"
  prompt_value SANDBOX_DOMAIN "Sandbox DNS domain (example: sandbox.example.com)"
  prompt_value ACME_EMAIL "ACME notification email"
  prompt_value SANDBOX_ADMIN_EMAIL "Initial sandbox administrator email"
  prompt_value SEPOLIA_RPC_URL "Private Sepolia RPC URL" true
  prompt_value SEPOLIA_BROWSER_RPC_URL "Public browser-safe Sepolia RPC URL"
  prompt_value SOPS_AGE_RECIPIENT "age recipient (age1...)"
  "${repo_root}/tools/init-secrets"
}

guarded_broadcast() {
  require_runtime_environment
  local chain_id
  local expected
  local prepared_manifest
  local runtime_dir
  local typed
  chain_id=$(environment_value L2_CHAIN_ID)
  if [[ ! "$chain_id" =~ ^[0-9]+$ ]]; then
    echo "L2_CHAIN_ID is missing or invalid in ${runtime_environment}" >&2
    exit 1
  fi
  runtime_dir=$(environment_value RUNTIME_DIR)
  if [[ -z "$runtime_dir" ]]; then
    echo "RUNTIME_DIR is missing from ${runtime_environment}" >&2
    exit 1
  fi
  if [[ "$runtime_dir" != /* ]]; then
    runtime_dir="${repo_root}/${runtime_dir}"
  fi
  prepared_manifest="${runtime_dir}/chain/out/manifest.json"
  if [[ ! -s "$prepared_manifest" ]]; then
    echo "No prepared deployment was found at ${prepared_manifest}" >&2
    echo "Run tools/sandbox prepare and review its output before broadcasting." >&2
    exit 1
  fi
  expected="BROADCAST_SEPOLIA_${chain_id}"

  printf "Running the mandatory pre-broadcast readiness gate...\n\n"
  SANDBOX_ENV_FILE="$runtime_environment" \
    SANDBOX_SECRETS_FILE="$encrypted_environment" \
    "${repo_root}/tools/readiness"
  printf "\nReadiness passed. The following confirmation authorizes irreversible Sepolia transactions.\n\n"

  if [[ "${CONFIRM_BROADCAST:-}" != "$expected" ]]; then
    if [[ ! -t 0 ]]; then
      echo "Non-interactive broadcast requires CONFIRM_BROADCAST=${expected}" >&2
      exit 1
    fi
    printf "This submits irreversible contract deployment transactions to Ethereum Sepolia.\n"
    printf "L2 chain ID: %s\n" "$chain_id"
    printf "Review the prepare output before continuing.\n\n"
    read -r -p "Type the L2 chain ID to broadcast: " typed
    if [[ "$typed" != "$chain_id" ]]; then
      echo "Confirmation did not match; nothing was broadcast." >&2
      exit 1
    fi
    export CONFIRM_BROADCAST="$expected"
  fi

  SANDBOX_ENV_FILE="$runtime_environment" "${repo_root}/tools/chain-bootstrap" broadcast
}

enable_profile() {
  require_runtime_environment
  local feature="${1:-}"
  local profiles=()
  case "$feature" in
    sso)
      if [[ "$(environment_value BUNDLER_ENABLED)" != "true" ]]; then
        echo "SSO requires BUNDLER_ENABLED=true in the encrypted environment." >&2
        echo "Run tools/sandbox edit-secrets, then tools/sandbox decrypt." >&2
        exit 1
      fi
      echo "SSO/bundler funding is incremental and outside the core 1 ETH guarantee."
      SANDBOX_ENV_FILE="$runtime_environment" \
        "${repo_root}/tools/optional-funding-check" sso
      profiles=(--profile sso)
      ;;
    webhook)
      if [[ "$(environment_value WEBHOOK_ENABLED)" != "true" ]]; then
        echo "Webhooks require WEBHOOK_ENABLED=true in the encrypted environment." >&2
        echo "Run tools/sandbox edit-secrets, then tools/sandbox decrypt." >&2
        exit 1
      fi
      profiles=(--profile webhook)
      ;;
    demo)
      if [[ "$(environment_value BUNDLER_ENABLED)" != "true" ]]; then
        echo "The demo requires BUNDLER_ENABLED=true because it uses SSO." >&2
        echo "Run tools/sandbox edit-secrets, then tools/sandbox decrypt." >&2
        exit 1
      fi
      echo "SSO/bundler and demo funding are incremental and outside the core 1 ETH guarantee."
      SANDBOX_ENV_FILE="$runtime_environment" \
        "${repo_root}/tools/optional-funding-check" institutional-demo
      profiles=(--profile sso --profile institutional-demo)
      ;;
    *)
      echo "Usage: tools/sandbox enable <sso|webhook|demo>" >&2
      exit 1
      ;;
  esac

  cd "$repo_root"
  "${repo_root}/tools/validate-stack" "$runtime_environment"
  docker compose --env-file "$runtime_environment" "${profiles[@]}" up -d --build
}

command="${1:-help}"
shift || true

case "$command" in
  help|-h|--help)
    usage
    ;;
  doctor)
    "${repo_root}/tools/doctor"
    ;;
  init)
    guided_init
    ;;
  decrypt)
    RUNTIME_DIR=$(dirname "$runtime_environment") \
      "${repo_root}/tools/decrypt-secrets" "$encrypted_environment"
    ;;
  edit-secrets)
    command -v sops >/dev/null || {
      echo "sops is required" >&2
      exit 1
    }
    if [[ ! -s "$encrypted_environment" ]]; then
      echo "Encrypted environment not found: ${encrypted_environment}" >&2
      exit 1
    fi
    sops "$encrypted_environment"
    ;;
  funding)
    SANDBOX_SECRETS_FILE="$encrypted_environment" \
      "${repo_root}/tools/funding" "${1:-plan}"
    ;;
  roles)
    SANDBOX_SECRETS_FILE="$encrypted_environment" \
      "${repo_root}/tools/role-report"
    ;;
  prepare)
    require_runtime_environment
    SANDBOX_ENV_FILE="$runtime_environment" "${repo_root}/tools/chain-bootstrap" prepare
    ;;
  readiness)
    require_runtime_environment
    SANDBOX_ENV_FILE="$runtime_environment" \
      SANDBOX_SECRETS_FILE="$encrypted_environment" \
      "${repo_root}/tools/readiness"
    ;;
  broadcast)
    guarded_broadcast
    ;;
  deploy)
    require_runtime_environment
    SANDBOX_ENV_FILE="$runtime_environment" "${repo_root}/tools/deploy"
    ;;
  summary)
    require_runtime_environment
    SANDBOX_ENV_FILE="$runtime_environment" \
      "${repo_root}/tools/deployment-summary"
    ;;
  enable)
    enable_profile "${1:-}"
    ;;
  status)
    require_runtime_environment
    cd "$repo_root"
    docker compose --env-file "$runtime_environment" --profile "*" ps
    ;;
  logs)
    require_runtime_environment
    cd "$repo_root"
    if (( $# )); then
      docker compose --env-file "$runtime_environment" --profile "*" logs --tail 200 --follow "$@"
    else
      docker compose --env-file "$runtime_environment" logs --tail 200 --follow \
        chain-preflight zksyncos prividium-api caddy
    fi
    ;;
  validate)
    if [[ -s "$runtime_environment" ]]; then
      "${repo_root}/tools/validate-stack" "$runtime_environment"
    else
      "${repo_root}/tools/validate-stack" "${repo_root}/deployment/sandbox.env.example"
    fi
    ;;
  components)
    cat <<'EOF'
Compose component map

  docker-compose.yaml                    Core UI, API, and Caddy entrypoint
  docker-compose-platform.yaml           PostgreSQL, Keycloak, chain bootstrap, ZKsync OS
  docker-compose-explorer.yaml           Explorer API, UI, worker, and data fetcher
  docker-compose-permissioning.yaml       Idempotent Watchdog, webhook, and SSO permission jobs
  docker-compose-monitoring.yaml         Watchdog, Prometheus, Grafana, balance exporter
  docker-compose-optional.yaml           SSO/bundler and webhook runtime
  docker-compose-demos.yaml              Institutional demo identity, setup, seed, and app

Always invoke Docker Compose from the root docker-compose.yaml; it includes every component file.
EOF
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 1
    ;;
esac
