#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
export LC_ALL=C

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
encrypted_file="${SANDBOX_SECRETS_FILE:-${repo_root}/deployment/secrets/sandbox.enc.env}"
targets_file="${FUNDING_TARGETS_FILE:-${repo_root}/deployment/funding-targets.json}"
public_manifest="${PUBLIC_MANIFEST_PATH:-${repo_root}/deployment/public/manifest.json}"
funding_evidence="${RUNTIME_DIR:-/etc/prividium/runtime}/reports/funding-ready.json"
from_environment="false"
check_only="false"

ensure_prebroadcast() {
  if [[ -e "$public_manifest" || -L "$public_manifest" ]]; then
    if (( ${mutation_attempted:-0} > 0 )); then
      print_manual_review
    else
      echo "FUNDING BLOCKED" >&2
    fi
    echo "The protocol manifest already exists; initial role funding is pre-broadcast only." >&2
    exit 1
  fi
}

while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --from-environment)
      from_environment="true"
      ;;
    --check)
      check_only="true"
      ;;
    *)
      echo "Usage: tools/funding-reconcile [--check] [all|deployment|operators]" >&2
      exit 1
      ;;
  esac
  shift
done

scope="${1:-all}"
shift || true
if (( $# )); then
  echo "Usage: tools/funding-reconcile [--check] [all|deployment|operators]" >&2
  exit 1
fi
case "$scope" in
  all|deployment|operators) ;;
  *)
    echo "Unknown funding scope: ${scope}" >&2
    exit 1
    ;;
esac

ensure_prebroadcast

if [[ "$from_environment" != "true" ]]; then
  command -v sops >/dev/null || {
    echo "sops is required to read the encrypted sandbox configuration" >&2
    exit 1
  }
  if [[ ! -s "$encrypted_file" ]]; then
    echo "Encrypted sandbox configuration not found: ${encrypted_file}" >&2
    echo "Run: ./cli/prividium init" >&2
    exit 1
  fi
  export PRIVIDIUM_FUNDING_RECONCILE_SCRIPT="${BASH_SOURCE[0]}"
  export PRIVIDIUM_FUNDING_SCOPE="$scope"
  export PRIVIDIUM_FUNDING_CHECK_ONLY="$check_only"
  exec sops exec-env "$encrypted_file" \
    'if [ "$PRIVIDIUM_FUNDING_CHECK_ONLY" = "true" ]; then
       exec "$PRIVIDIUM_FUNDING_RECONCILE_SCRIPT" --from-environment --check "$PRIVIDIUM_FUNDING_SCOPE"
     else
       exec "$PRIVIDIUM_FUNDING_RECONCILE_SCRIPT" --from-environment "$PRIVIDIUM_FUNDING_SCOPE"
     fi'
fi

source "${repo_root}/tools/lib/sandbox-roles.sh"
source "${repo_root}/tools/lib/funding-targets.sh"

rows_file=""
canonical_file=""
snapshot_dir=""
snapshot_files=()
snapshot_pids=()
signer_dir=""
signer_keystore=""
signer_password_file=""
funding_evidence_tmp=""
lock_dir="${repo_root}/deployment/secrets/.fund.lock"
lock_acquired="false"
mutation_attempted=0
transfers_confirmed=0

cleanup() {
  local file
  local pid
  if (( ${#snapshot_pids[@]} )); then
    for pid in "${snapshot_pids[@]}"; do
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    done
  fi
  if (( ${#snapshot_files[@]} )); then
    for file in "${snapshot_files[@]}"; do
      rm -f -- "$file"
    done
  fi
  if [[ -n "$snapshot_dir" ]]; then
    rmdir "$snapshot_dir" 2>/dev/null || true
  fi
  if [[ -n "$rows_file" ]]; then
    rm -f "$rows_file"
  fi
  if [[ -n "$canonical_file" ]]; then
    rm -f "$canonical_file"
  fi
  if [[ -n "$signer_keystore" ]]; then
    rm -f -- "$signer_keystore"
  fi
  if [[ -n "$signer_password_file" ]]; then
    rm -f -- "$signer_password_file"
  fi
  if [[ -n "$signer_dir" ]]; then
    rmdir "$signer_dir" 2>/dev/null || true
  fi
  if [[ -n "$funding_evidence_tmp" ]]; then
    rm -f -- "$funding_evidence_tmp"
  fi
  if [[ "$lock_acquired" == "true" ]]; then
    rmdir "$lock_dir" 2>/dev/null || true
  fi
}
trap cleanup EXIT

print_manual_review() {
  echo "PARTIALLY FUNDED — MANUAL REVIEW REQUIRED" >&2
  echo "${transfers_confirmed} transfer(s) were independently verified before the failure." >&2
  echo "A submitted transaction may still be pending even if no hash was returned." >&2
  echo "Inspect the funding-wallet nonce and receipts before retrying." >&2
}

handle_unexpected_error() {
  local status=$?
  trap - ERR
  if (( BASH_SUBSHELL > 0 )); then
    exit "$status"
  fi
  if (( mutation_attempted > 0 )); then
    print_manual_review
    echo "An unexpected error interrupted funding." >&2
  fi
  exit "$status"
}
trap handle_unexpected_error ERR

for required_command in cast jq openssl; do
  command -v "$required_command" >/dev/null || {
    echo "${required_command} is required" >&2
    exit 1
  }
done

: "${SEPOLIA_RPC_URL:?SEPOLIA_RPC_URL is missing from the encrypted configuration}"
: "${L2_CHAIN_ID:?L2_CHAIN_ID is missing from the encrypted configuration}"
: "${BRIDGE_SPONSOR_PRIVATE_KEY:?BRIDGE_SPONSOR_PRIVATE_KEY is missing from the encrypted configuration}"
: "${BRIDGE_SPONSOR_KEYSTORE_B64:?BRIDGE_SPONSOR_KEYSTORE_B64 is missing from the encrypted configuration}"
: "${BRIDGE_SPONSOR_KEYSTORE_PASSWORD:?BRIDGE_SPONSOR_KEYSTORE_PASSWORD is missing from the encrypted configuration}"
export ETH_RPC_URL="$SEPOLIA_RPC_URL"
export ETH_RPC_TIMEOUT="${ETH_RPC_TIMEOUT:-15}"

sandbox_load_role_addresses

signer_dir=$(mktemp -d)
chmod 0700 "$signer_dir"
signer_keystore="${signer_dir}/sponsor"
signer_password_file="${signer_dir}/password"
if ! printf "%s" "$BRIDGE_SPONSOR_KEYSTORE_B64" |
  openssl base64 -d -A >"$signer_keystore"; then
  echo "FUNDING BLOCKED" >&2
  echo "The encrypted Sandbox funding-wallet keystore is invalid." >&2
  exit 1
fi
printf "%s\n" "$BRIDGE_SPONSOR_KEYSTORE_PASSWORD" >"$signer_password_file"
chmod 0600 "$signer_keystore" "$signer_password_file"
if ! keystore_sponsor_address=$(
  unset \
    BRIDGE_SPONSOR_PRIVATE_KEY \
    BRIDGE_SPONSOR_KEYSTORE_B64 \
    BRIDGE_SPONSOR_KEYSTORE_PASSWORD
  cast wallet address \
    --keystore "$signer_keystore" \
    --password-file "$signer_password_file" 2>/dev/null
); then
  echo "FUNDING BLOCKED" >&2
  echo "The Sandbox funding-wallet keystore could not be unlocked." >&2
  exit 1
fi
configured_sponsor_address=$(sandbox_role_address bridge_sponsor)
keystore_sponsor_lower=$(
  printf "%s" "$keystore_sponsor_address" | sandbox_lowercase
)
configured_sponsor_lower=$(
  printf "%s" "$configured_sponsor_address" | sandbox_lowercase
)
if [[ "$keystore_sponsor_lower" != "$configured_sponsor_lower" ]]; then
  echo "FUNDING BLOCKED" >&2
  echo "The Sandbox funding-wallet keystore does not match its configured identity." >&2
  exit 1
fi

if ! sandbox_validate_funding_targets "$targets_file" >/dev/null 2>&1; then
  echo "Sandbox funding targets are missing or invalid" >&2
  exit 1
fi
sandbox_validate_distinct_roles

role_inventory="${repo_root}/deployment/public/roles.md"
if [[ ! -s "$role_inventory" ]]; then
  echo "Public role inventory not found: ${role_inventory}" >&2
  echo "Start from a fresh ./cli/prividium init identity set before funding." >&2
  exit 1
fi
inventory_fingerprint=$(
  awk -F'`' '/^- Role-set fingerprint: `/ { print $2; exit }' "$role_inventory"
)
expected_fingerprint=$(sandbox_role_fingerprint)
if [[ ! "$inventory_fingerprint" =~ ^[0-9a-fA-F]{64}$ ||
      "$inventory_fingerprint" != "$expected_fingerprint" ]]; then
  echo "FUNDING BLOCKED" >&2
  echo "The public role inventory does not match the encrypted sandbox identities." >&2
  echo "Resolve the configuration mismatch before funding any address." >&2
  exit 1
fi

if [[ "$check_only" == "true" ]]; then
  if [[ -e "$lock_dir" || -L "$lock_dir" ]]; then
    echo "ACTION REQUIRED"
    echo "Another sandbox funding command is already running."
    echo "Wait for it to finish, then rerun this check."
    exit 2
  fi
else
  if ! mkdir "$lock_dir" 2>/dev/null; then
    echo "ACTION REQUIRED"
    echo "Another sandbox funding command is already running."
    echo "If no funding process is active, remove this stale lock and retry:"
    echo "  ${lock_dir}"
    exit 2
  fi
  lock_acquired="true"
fi

if ! actual_l1_chain_id=$(cast chain-id 2>/dev/null); then
  if [[ "$check_only" == "true" ]]; then
    echo "ACTION REQUIRED"
    echo "Unable to recheck the configured Sepolia RPC."
    echo "Retry after RPC connectivity is restored."
    exit 2
  fi
  echo "FUNDING BLOCKED" >&2
  echo "Unable to read the configured L1 chain ID." >&2
  exit 1
fi
if [[ "$actual_l1_chain_id" != "11155111" ]]; then
  echo "Configured L1 RPC returned chain ID ${actual_l1_chain_id}; expected Sepolia (11155111)." >&2
  exit 1
fi

case "$scope" in
  all)
    selected_roles=("${sandbox_funded_role_ids[@]}")
    scope_label="deployment + operators"
    ;;
  deployment)
    selected_roles=("${sandbox_deployment_role_ids[@]}")
    scope_label="deployment"
    ;;
  operators)
    selected_roles=("${sandbox_operator_role_ids[@]}")
    scope_label="operators"
    ;;
esac

rows_file=$(mktemp)
canonical_file=$(mktemp)
snapshot_dir=$(mktemp -d)

format_eth() {
  local formatted
  formatted=$(cast from-wei "$1")
  if [[ "$formatted" == *.* ]]; then
    while [[ "${formatted: -1}" == "0" ]]; do
      formatted="${formatted%0}"
    done
    formatted="${formatted%.}"
  fi
  printf "%s\n" "$formatted"
}

decimal_normalize() {
  local value="$1"
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  while [[ ${#value} -gt 1 && "${value:0:1}" == "0" ]]; do
    value="${value:1}"
  done
  printf "%s" "$value"
}

decimal_compare() {
  local left
  local right
  left=$(decimal_normalize "$1") || return 1
  right=$(decimal_normalize "$2") || return 1
  if (( ${#left} < ${#right} )); then
    printf "%s" "-1"
  elif (( ${#left} > ${#right} )); then
    printf "%s" "1"
  elif [[ "$left" == "$right" ]]; then
    printf "%s" "0"
  elif [[ "$left" < "$right" ]]; then
    printf "%s" "-1"
  else
    printf "%s" "1"
  fi
}

decimal_less_than() {
  [[ "$(decimal_compare "$1" "$2")" == "-1" ]]
}

decimal_add() {
  local left
  local right
  local left_index
  local right_index
  local left_digit
  local right_digit
  local carry=0
  local sum
  local result=""

  left=$(decimal_normalize "$1") || return 1
  right=$(decimal_normalize "$2") || return 1
  left_index=$((${#left} - 1))
  right_index=$((${#right} - 1))
  while (( left_index >= 0 || right_index >= 0 || carry > 0 )); do
    left_digit=0
    right_digit=0
    if (( left_index >= 0 )); then
      left_digit="${left:left_index:1}"
    fi
    if (( right_index >= 0 )); then
      right_digit="${right:right_index:1}"
    fi
    sum=$((left_digit + right_digit + carry))
    result="$((sum % 10))${result}"
    carry=$((sum / 10))
    left_index=$((left_index - 1))
    right_index=$((right_index - 1))
  done
  decimal_normalize "$result"
}

decimal_subtract() {
  local left
  local right
  local left_index
  local right_index
  local left_digit
  local right_digit
  local borrow=0
  local difference
  local result=""

  left=$(decimal_normalize "$1") || return 1
  right=$(decimal_normalize "$2") || return 1
  if decimal_less_than "$left" "$right"; then
    return 1
  fi
  left_index=$((${#left} - 1))
  right_index=$((${#right} - 1))
  while (( left_index >= 0 )); do
    left_digit="${left:left_index:1}"
    right_digit=0
    if (( right_index >= 0 )); then
      right_digit="${right:right_index:1}"
    fi
    difference=$((left_digit - right_digit - borrow))
    if (( difference < 0 )); then
      difference=$((difference + 10))
      borrow=1
    else
      borrow=0
    fi
    result="${difference}${result}"
    left_index=$((left_index - 1))
    right_index=$((right_index - 1))
  done
  decimal_normalize "$result"
}

decimal_multiply_small() {
  local value
  local multiplier="$2"
  local index
  local digit
  local carry=0
  local product
  local result=""

  value=$(decimal_normalize "$1") || return 1
  if [[ ! "$multiplier" =~ ^[0-9]+$ ]] || (( multiplier > 1000000000 )); then
    return 1
  fi
  index=$((${#value} - 1))
  while (( index >= 0 )); do
    digit="${value:index:1}"
    product=$((digit * multiplier + carry))
    result="$((product % 10))${result}"
    carry=$((product / 10))
    index=$((index - 1))
  done
  while (( carry > 0 )); do
    result="$((carry % 10))${result}"
    carry=$((carry / 10))
  done
  decimal_normalize "${result:-0}"
}

launch_snapshot_command() {
  local output_file="$1"
  shift
  snapshot_files+=("$output_file")
  "$@" >"$output_file" 2>/dev/null &
  snapshot_pids+=("$!")
}

wait_for_snapshot_commands() {
  local failed="false"
  local pid
  for pid in "${snapshot_pids[@]}"; do
    if ! wait "$pid"; then
      failed="true"
    fi
  done
  snapshot_pids=()
  [[ "$failed" == "false" ]]
}

load_plan() {
  local addresses=()
  local role
  local address
  local current
  local index
  local nonce_value
  local target
  local shortfall

  : >"$rows_file"
  total_shortfall=0
  recipient_count=0
  snapshot_pids=()

  for role in "${selected_roles[@]}"; do
    address=$(sandbox_role_address "$role")
    addresses+=("$address")
    launch_snapshot_command \
      "${snapshot_dir}/balance-${role}" \
      cast balance "$address"
  done

  sponsor_address=$(sandbox_role_address bridge_sponsor)
  launch_snapshot_command \
    "${snapshot_dir}/latest-nonce" \
    cast rpc eth_getTransactionCount "$sponsor_address" latest
  launch_snapshot_command \
    "${snapshot_dir}/pending-nonce" \
    cast rpc eth_getTransactionCount "$sponsor_address" pending
  launch_snapshot_command \
    "${snapshot_dir}/sponsor-balance" \
    cast balance "$sponsor_address"
  if [[ "$check_only" != "true" ]]; then
    launch_snapshot_command \
      "${snapshot_dir}/gas-price" \
      cast gas-price
  fi

  if ! wait_for_snapshot_commands; then
    funding_failure "Unable to read the live Sepolia funding state." transient
  fi

  for ((index = 0; index < ${#selected_roles[@]}; index++)); do
    role="${selected_roles[$index]}"
    address="${addresses[$index]}"
    current=$(<"${snapshot_dir}/balance-${role}")
    target=$(sandbox_funding_target "$targets_file" "$role")
    if ! current=$(decimal_normalize "$current") ||
       ! target=$(decimal_normalize "$target"); then
      funding_failure "Unable to read a numeric balance or target for ${role}."
    fi
    if decimal_less_than "$current" "$target"; then
      shortfall=$(decimal_subtract "$target" "$current")
      recipient_count=$((recipient_count + 1))
    else
      shortfall=0
    fi
    total_shortfall=$(decimal_add "$total_shortfall" "$shortfall")
    printf "%s\t%s\t%s\t%s\t%s\n" \
      "$role" "$address" "$current" "$target" "$shortfall" >>"$rows_file"
  done

  sponsor_balance=$(<"${snapshot_dir}/sponsor-balance")
  canary_reserve=$(sandbox_canary_reserve "$targets_file")
  if ! sponsor_balance=$(decimal_normalize "$sponsor_balance") ||
     ! canary_reserve=$(decimal_normalize "$canary_reserve"); then
    funding_failure "Unable to read the funding-wallet balance or canary reserve."
  fi

  if [[ "$check_only" == "true" ]]; then
    gas_price=0
    fee_allowance=0
    required_sponsor_balance=$(decimal_add "$total_shortfall" "$canary_reserve")
  else
    gas_price=$(<"${snapshot_dir}/gas-price")
    if ! gas_price=$(decimal_normalize "$gas_price"); then
      funding_failure "Unable to read a numeric funding-wallet balance or Sepolia gas price."
    fi

    fee_allowance=$(decimal_multiply_small "$gas_price" 21000)
    fee_allowance=$(decimal_multiply_small "$fee_allowance" "$recipient_count")
    fee_allowance=$(decimal_multiply_small "$fee_allowance" 2)
    required_sponsor_balance=$(decimal_add "$total_shortfall" "$fee_allowance")
    required_sponsor_balance=$(decimal_add "$required_sponsor_balance" "$canary_reserve")
  fi

  nonce_value=$(<"${snapshot_dir}/latest-nonce")
  latest_nonce=$(printf "%s" "$nonce_value" | tr -d '"')
  nonce_value=$(<"${snapshot_dir}/pending-nonce")
  pending_nonce=$(printf "%s" "$nonce_value" | tr -d '"')
  if [[ ! "$latest_nonce" =~ ^0x[0-9a-fA-F]+$ ||
        ! "$pending_nonce" =~ ^0x[0-9a-fA-F]+$ ]]; then
    funding_failure "Unable to read a valid Sandbox funding-wallet nonce."
  fi

  {
    printf "scope=%s\n" "$scope"
    printf "l1_chain_id=11155111\n"
    printf "l2_chain_id=%s\n" "$L2_CHAIN_ID"
    printf "sponsor=%s\n" "$(printf "%s" "$sponsor_address" | sandbox_lowercase)"
    printf "sponsor_balance=%s\n" "$sponsor_balance"
    printf "latest_nonce=%s\n" "$latest_nonce"
    printf "pending_nonce=%s\n" "$pending_nonce"
    cat "$rows_file"
  } >"$canonical_file"
  plan_id=$(sandbox_sha256 <"$canonical_file")
}

print_plan() {
  local role
  local address
  local current
  local target
  local shortfall

  printf "Prividium sandbox funding\n"
  printf "Profile: sandbox\n"
  printf "Network: Ethereum Sepolia (11155111)\n"
  printf "Scope: %s\n\n" "$scope_label"
  printf "Funding wallet: %s\n" "$sponsor_address"
  printf "Confirmed balance: %s ETH\n\n" "$(format_eth "$sponsor_balance")"
  printf "%-12s %-21s %-42s %12s %12s %12s\n" \
    "GROUP" "ROLE" "ADDRESS" "CURRENT" "TARGET" "ADD"
  while IFS=$'\t' read -r role address current target shortfall; do
    printf "%-12s %-21s %-42s %12s %12s %12s\n" \
      "$(sandbox_funding_role_group "$role")" \
      "$(sandbox_role_label "$role")" \
      "$address" \
      "$(format_eth "$current")" \
      "$(format_eth "$target")" \
      "$(format_eth "$shortfall")"
  done <"$rows_file"
  printf "\nTotal to distribute: %s Sepolia ETH\n" "$(format_eth "$total_shortfall")"
  printf "Estimated distribution gas: %s Sepolia ETH\n" "$(format_eth "$fee_allowance")"
  printf "Reserved for the acceptance canary: %s Sepolia ETH\n" "$(format_eth "$canary_reserve")"
  printf "Required funding-wallet balance: %s Sepolia ETH\n" \
    "$(format_eth "$required_sponsor_balance")"
}

write_funding_evidence() {
  local targets_sha256

  [[ "$scope" == "all" && "$check_only" != "true" ]] || return
  targets_sha256=$(sandbox_sha256 <"$targets_file")
  mkdir -p "$(dirname "$funding_evidence")"
  funding_evidence_tmp=$(mktemp "${funding_evidence}.tmp.XXXXXX")
  jq -n \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson l2_chain_id "$L2_CHAIN_ID" \
    --arg role_set_fingerprint "$expected_fingerprint" \
    --arg canary_reserve_wei "$canary_reserve" \
    --arg funding_targets_sha256 "$targets_sha256" \
    '{
      schema_version: 1,
      status: "FUNDED",
      generated_at: $generated_at,
      l1_chain_id: 11155111,
      l2_chain_id: $l2_chain_id,
      role_set_fingerprint: $role_set_fingerprint,
      canary_reserve_wei: $canary_reserve_wei,
      funding_targets_sha256: $funding_targets_sha256
    }' >"$funding_evidence_tmp"
  install -m 0600 "$funding_evidence_tmp" "$funding_evidence"
  rm -f -- "$funding_evidence_tmp"
  funding_evidence_tmp=""
}

funding_failure() {
  local message="$1"
  local kind="${2:-invalid}"
  if [[ "$check_only" == "true" && "$mutation_attempted" == "0" ]]; then
    if [[ "$kind" == "transient" ]]; then
      echo "ACTION REQUIRED"
      echo "$message"
      echo "Retry after RPC connectivity is restored."
      exit 2
    fi
    echo "FUNDING BLOCKED" >&2
    echo "$message" >&2
    echo "The live funding response or local funding configuration is invalid." >&2
    exit 1
  fi
  if (( mutation_attempted > 0 )); then
    print_manual_review
  else
    echo "FUNDING BLOCKED" >&2
  fi
  echo "$message" >&2
  exit 1
}

wait_for_transaction_receipt() {
  local transaction_hash="$1"
  local deadline=$((SECONDS + 180))
  local receipt
  local receipt_hash
  local receipt_hash_lower
  local receipt_status
  local transaction_hash_lower

  while (( SECONDS < deadline )); do
    if receipt=$(cast receipt "$transaction_hash" --async --json 2>/dev/null); then
      receipt_hash=$(
        jq -r '.transactionHash // .transaction_hash // empty' <<<"$receipt" 2>/dev/null
      )
      receipt_status=$(jq -r '.status // empty' <<<"$receipt" 2>/dev/null)
      receipt_hash_lower=$(printf "%s" "$receipt_hash" | sandbox_lowercase)
      transaction_hash_lower=$(printf "%s" "$transaction_hash" | sandbox_lowercase)
      if [[ "$receipt_hash_lower" != "$transaction_hash_lower" ]]; then
        return 1
      fi
      if [[ "$receipt_status" == "0x1" || "$receipt_status" == "1" ]]; then
        return 0
      fi
      if [[ "$receipt_status" == "0x0" || "$receipt_status" == "0" ]]; then
        return 2
      fi
    fi
    sleep 2
  done
  return 1
}

load_plan
if [[ "$check_only" != "true" ]]; then
  print_plan
fi

if [[ "$check_only" == "true" &&
      ( -e "$lock_dir" || -L "$lock_dir" ) ]]; then
  printf "\nACTION REQUIRED\n"
  printf "Sandbox funding changed while this check was running.\n"
  printf "Wait for funding to finish, then rerun this check.\n"
  exit 2
fi

if [[ "$check_only" == "true" && "$pending_nonce" != "$latest_nonce" ]]; then
  printf "\nACTION REQUIRED\n"
  printf "The Sandbox funding wallet has a pending Sepolia transaction.\n"
  printf "Wait for it to confirm or disappear, then rerun this check.\n"
  exit 2
fi

if [[ "$check_only" == "true" ]]; then
  if [[ "$total_shortfall" != "0" ]]; then
    printf "\nACTION REQUIRED\n"
    printf "%s role(s) remain below their evaluation funding target.\n" "$recipient_count"
    printf "Run: ./cli/prividium fund"
    if [[ "$scope" != "all" ]]; then
      printf " %s" "$scope"
    fi
    printf "\n"
    exit 2
  fi
  if decimal_less_than "$sponsor_balance" "$required_sponsor_balance"; then
    printf "\nACTION REQUIRED\n"
    printf "The Sandbox funding wallet is below its acceptance-canary reserve.\n"
    printf "Run: ./cli/prividium fund\n"
    exit 2
  fi
fi

if [[ "$total_shortfall" == "0" ]] &&
   ! decimal_less_than "$sponsor_balance" "$required_sponsor_balance"; then
  write_funding_evidence
  printf "\nNO FUNDING CHANGES REQUIRED\n"
  printf "Funding requirements are already satisfied for %s.\n" "$scope_label"
  if [[ "$scope" == "all" ]]; then
    printf "Funding step complete.\n"
    printf "Next: ./cli/prividium preflight\n"
  else
    printf "Next: ./cli/prividium fund\n"
  fi
  exit 0
fi

if [[ "$pending_nonce" != "$latest_nonce" ]]; then
  printf "\nACTION REQUIRED\n"
  printf "The Sandbox funding wallet has a pending Sepolia transaction.\n"
  printf "Wait for it to confirm or disappear, then rerun this command.\n"
  exit 2
fi

if decimal_less_than "$sponsor_balance" "$required_sponsor_balance"; then
  additional_required=$(decimal_subtract "$required_sponsor_balance" "$sponsor_balance")
  printf "\nACTION REQUIRED\n"
  printf "Add at least %s Sepolia ETH to:\n\n" "$(format_eth "$additional_required")"
  printf "%s\n\n" "$sponsor_address"
  printf "Then rerun: ./cli/prividium fund"
  if [[ "$scope" != "all" ]]; then
    printf " %s" "$scope"
  fi
  printf "\n"
  exit 2
fi

if [[ ! -t 0 ]]; then
  echo "FUNDING BLOCKED" >&2
  echo "Funding transfers require an interactive terminal for confirmation." >&2
  exit 1
fi

printf "\nThis submits %s irreversible Sepolia testnet transfer(s).\n" "$recipient_count"
read -r -p "Fund these addresses? [y/N] " confirmation
case "$confirmation" in
  y|Y|yes|YES) ;;
  *)
    printf "Funding declined; no transfers were submitted.\n"
    exit 2
    ;;
esac

approved_plan_id="$plan_id"
load_plan
if [[ "$plan_id" != "$approved_plan_id" ]]; then
  echo "FUNDING BLOCKED" >&2
  echo "Balances or nonce changed after confirmation; rerun to review the new plan." >&2
  exit 1
fi
ensure_prebroadcast
if decimal_less_than "$sponsor_balance" "$required_sponsor_balance"; then
  echo "FUNDING BLOCKED" >&2
  echo "The funding wallet can no longer cover the selected transfers and current fee allowance." >&2
  exit 1
fi

while IFS=$'\t' read -r role address _current target shortfall; do
  if [[ "$shortfall" == "0" ]]; then
    continue
  fi
  if ! current=$(cast balance "$address" 2>/dev/null); then
    funding_failure "Unable to recheck $(sandbox_role_label "$role") before transfer."
  fi
  if [[ ! "$current" =~ ^[0-9]+$ ]]; then
    funding_failure "The balance recheck for $(sandbox_role_label "$role") was not numeric."
  fi
  current=$(decimal_normalize "$current")
  if ! decimal_less_than "$current" "$target"; then
    printf "✓ %s is already funded\n" "$(sandbox_role_label "$role")"
    continue
  fi
  shortfall=$(decimal_subtract "$target" "$current")
  printf "Funding %s with %s Sepolia ETH...\n" \
    "$(sandbox_role_label "$role")" "$(format_eth "$shortfall")"
  ensure_prebroadcast
  mutation_attempted=1
  if ! transaction=$(
    unset \
      BRIDGE_SPONSOR_PRIVATE_KEY \
      BRIDGE_SPONSOR_KEYSTORE_B64 \
      BRIDGE_SPONSOR_KEYSTORE_PASSWORD
    cast send "$address" \
      --value "${shortfall}wei" \
      --keystore "$signer_keystore" \
      --password-file "$signer_password_file" \
      --async 2>/dev/null
  ); then
    funding_failure "The transfer for $(sandbox_role_label "$role") failed."
  fi
  transaction_hash=$(
    printf "%s\n" "$transaction" |
      grep -Eo '0x[0-9a-fA-F]{64}' |
      head -n 1
  ) || true
  if [[ ! "$transaction_hash" =~ ^0x[0-9a-fA-F]{64}$ ]]; then
    funding_failure "The transfer for $(sandbox_role_label "$role") returned no valid transaction hash."
  fi
  printf "✓ Submitted %s\n" "$transaction_hash"
  printf "  Waiting for confirmation...\n"
  if wait_for_transaction_receipt "$transaction_hash"; then
    :
  else
    receipt_status=$?
    if [[ "$receipt_status" == "2" ]]; then
      funding_failure \
        "The transfer for $(sandbox_role_label "$role") reverted: ${transaction_hash}."
    fi
    funding_failure \
      "Timed out waiting for $(sandbox_role_label "$role") confirmation: ${transaction_hash}."
  fi
  if ! confirmed=$(cast balance "$address" 2>/dev/null); then
    funding_failure \
      "Unable to verify $(sandbox_role_label "$role") after ${transaction_hash}."
  fi
  if ! confirmed=$(decimal_normalize "$confirmed"); then
    funding_failure \
      "The confirmed balance for $(sandbox_role_label "$role") was not numeric after ${transaction_hash}."
  fi
  if decimal_less_than "$confirmed" "$target"; then
    funding_failure \
      "$(sandbox_role_label "$role") remains below target after ${transaction_hash}."
  fi
  transfers_confirmed=$((transfers_confirmed + 1))
  printf "✓ Confirmed %s\n" "$transaction_hash"
done <"$rows_file"

load_plan
if [[ "$total_shortfall" != "0" ]]; then
  funding_failure "One or more selected roles remain below their funding target."
fi
if decimal_less_than "$sponsor_balance" "$canary_reserve"; then
  funding_failure "The Sandbox funding wallet fell below its acceptance-canary reserve."
fi
write_funding_evidence
printf "\nFUNDING COMPLETE\n"
printf "Funding requirements satisfied for %s.\n" "$scope_label"
if [[ "$scope" == "all" ]]; then
  printf "Funding step complete.\n"
  printf "Next: ./cli/prividium preflight\n"
else
  printf "Next: ./cli/prividium fund\n"
fi
